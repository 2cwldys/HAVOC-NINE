+				t.layoutLogged = true;
+				UTIL_LogPrintf("[RCBOT BRIEF] %d briefcase(s), owners %d %d %d: only one base for each of two teams is played\n",
+					nBases, iOwner[0], iOwner[1], iOwner[2]);
