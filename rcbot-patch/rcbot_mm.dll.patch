+			pBot->m_Mech.onWeaponInfo(id, clip, ammo, gpGlobals->time);
+
 		if (!ammo && !clip)
 		{				// drop weapon
 			gBotGlobals.m_Bots[iIndex].AddPriorityTask(CBotTask(BOT_TASK_DROP_WEAPON));
