+		while ((pEnt = UTIL_FindEntityByClassname(pEnt, "ts_briefcase")) != nullptr)
+		{
+			if (nBases < 3)
+			{
+				pBase[nBases] = pEnt;
+				iOwner[nBases] = t.ownerOf(ENTINDEX(pEnt));
+			}
