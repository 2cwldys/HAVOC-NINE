+void BotClient_TS_Flag::execute(void* p, int iIndex)
+{
+	static int iAction;
+	static int iFlagId;
+	static int iTeam;
+
+	short* state = &gBotGlobals.m_iCurrentMessageState;
+
+	if (p == nullptr)
+	{
+		return;
+	}
+
+	const int iValue = *static_cast<int*>(p);
+
+	switch (POINTER_VALUE(state))
+	{
+	case 0:
+		iAction = iValue;
+		break;
+	case 1:
+		iFlagId = iValue;
+		break;
+	case 2:
+		iTeam = iValue;
+		break;
+	case 3:
+		if (brief::g_Brief.takeLog())
+			UTIL_LogPrintf("[RCBOT BRIEF] TSFlag: action %d, flag %d, team %d, carrier %d\n", iAction, iFlagId, iTeam, iValue);
+
+		brief::g_Brief.onFlag(iAction, iFlagId, iTeam, iValue, gpGlobals->time);
+		break;
+	default:
+		break;
+	}
+
+	POINTER_INCREMENT_VALUE(state);
+}
+
+void BotClient_TS_ScoreInfo::execute(void* p, int iIndex)
+{
+	static int iPlayer;
+
+	short* state = &gBotGlobals.m_iCurrentMessageState;
+
+	if (p == nullptr)
+	{
+		return;
+	}
+
+	const int iValue = *static_cast<int*>(p);
+
+	switch (POINTER_VALUE(state))
+	{
+	case 0:
+		iPlayer = iValue;
+		break;
+	case 4:
+		if (iPlayer >= 1 && iPlayer <= brief::MAX_SLOT && brief::g_Brief.teamOf[iPlayer] != iValue && brief::g_Brief.takeLog())
+			UTIL_LogPrintf("[RCBOT BRIEF] ScoreInfo: player %d is on team %d\n", iPlayer, iValue);
+
+		brief::g_Brief.onScore(iPlayer, iValue);
+		break;
+	default:
+		break;
+	}
+
+	POINTER_INCREMENT_VALUE(state);
+}
