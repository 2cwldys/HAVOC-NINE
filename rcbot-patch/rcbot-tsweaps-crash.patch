diff --git a/dlls/ga.cpp b/dlls/ga.cpp
index 923b8fc..2fe649f 100644
--- a/dlls/ga.cpp
+++ b/dlls/ga.cpp
@@ -160,6 +160,14 @@ void CPopulation::load(std::FILE* bfp, const int chromosize, const int type)
 
 		pVals->load(bfp, chromosize);
 
+		// one that did not load (a header that does not match, the file cut short) has no values: drop it, or a bot
+		// that picks it reads values[0] of an empty vector
+		if (type == TYPE_BOTGAVALS && static_cast<CBotGAValues*>(pVals)->size() == 0)
+		{
+			delete pVals;
+			continue;
+		}
+
 		m_theIndividuals.emplace_back(pVals);
 	}
