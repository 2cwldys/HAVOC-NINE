+	// A bot starts again: nothing of the post it had, or the posts it gave up, carries over.
+	void ObjForgetBot(const int iIndex)
+	{
+		if (iIndex < 1 || iIndex > MAX_PLAYERS)
+			return;
+
+		g_ObjBot[iIndex] = ObjBot();
