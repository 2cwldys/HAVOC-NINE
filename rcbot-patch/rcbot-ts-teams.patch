 {
+	// ---------------------------------------------------------------------
+	// The Specialists: drop a weapon that is completely dry.
+	//
+	// CanReload() for TS is  !m_iClip && *m_iAmmo1 > 0 , so a weapon with no clip
+	// AND no reserve is OutOfAmmo() and cannot be reloaded. Stock rcbot has no
+	// answer for that state: it keeps the empty weapon selected and keeps pulling
+	// the trigger, which is why bots stand there doing nothing with a gun raised.
+	//
+	// Dropping it makes the game hand them the next weapon they are carrying, and
+	// when there is nothing left that is bare hands -- which is at least a weapon.
+	//
+	// Rate limited per bot. 'drop' is a client command and spamming it every frame
+	// would throw away a weapon the moment it was picked up. The stamp is a static
+	// array rather than a new CBot member so this patch does not touch bot.h.
+	if (gBotGlobals.IsMod(MOD_TS) && m_pCurrentWeapon != nullptr
+		&& m_pCurrentWeapon->OutOfAmmo() && !m_pCurrentWeapon->CanReload())
+	{
+		static float s_fNextDryDrop[33] = { 0.0f };
+		const int iDryIdx = ENTINDEX(m_pEdict);
+
+		if (iDryIdx > 0 && iDryIdx < 33 && s_fNextDryDrop[iDryIdx] < gpGlobals->time)
+		{
+			s_fNextDryDrop[iDryIdx] = gpGlobals->time + 3.0f;
+			FakeClientCommand(m_pEdict, "drop");
+		}
+	}
