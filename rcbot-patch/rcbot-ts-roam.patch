+		// the clock starts again at each map, so a read due far ahead of it is due now
+		if (g_Roam.fNextRead <= gpGlobals->time || g_Roam.fNextRead > gpGlobals->time + 2.0f)
+		{
+			g_Roam.fNextRead = gpGlobals->time + 1.0f;
