+// Roaming citizens (CHANGE 8): the settings tsrp_roambots.sma gives them, read once a second.
+// ROAMING CITIZENS, over CBot::IsRoamer, says what each one does.
+namespace
+{
+	constexpr float ROAM_WALK_SPEED = 120.0f;
+	constexpr float ROAM_GOAL_NEAREST = 512.0f;
+	constexpr float ROAM_GOAL_FARTHEST = 3072.0f;
+	constexpr float ROAM_PAUSE_LEAST = 3.0f;
+	constexpr float ROAM_PAUSE_MOST = 10.0f;
+	constexpr int ROAM_GOAL_TRIES = 64;
+
+	struct RoamSettings
+	{
+		bool bOn = false;
+		bool bArmed = false;
+		float fWalk = ROAM_WALK_SPEED;
+		int iPause = 0;
+		float fNextRead = 0.0f;
+	};
+
+	RoamSettings g_Roam;
+
+	const RoamSettings& RoamNow()
+	{
+		// the clock starts again at each map, so a read due far ahead of it is due now
+		if (g_Roam.fNextRead <= gpGlobals->time || g_Roam.fNextRead > gpGlobals->time + 2.0f)
+		{
+			g_Roam.fNextRead = gpGlobals->time + 1.0f;
+			g_Roam.bOn = gBotGlobals.IsMod(MOD_TS) && CVAR_GET_FLOAT("tsrp_roambots_active") > 0.0f;
+			g_Roam.bArmed = CVAR_GET_FLOAT("tsrp_roambots_weapons") > 0.0f;
+
+			const float fWalk = CVAR_GET_FLOAT("tsrp_roambots_speed");
+			g_Roam.fWalk = fWalk > 0.0f ? fWalk : ROAM_WALK_SPEED;
+
+			const int iPause = static_cast<int>(CVAR_GET_FLOAT("tsrp_roambots_pause"));
+			g_Roam.iPause = std::min(std::max(iPause, 0), 100);
+		}
+
+		return g_Roam;
+	}
+}
