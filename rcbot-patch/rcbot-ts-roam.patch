+////////////////////////////////////////////////////////////////////////////////
+// ROAMING CITIZENS (rcbot-patch CHANGE 8)
+//
+// tsrp_roambots.sma fills a roleplay map with citizens: bots that walk the public streets at a
+// walk, stop now and then, and never fight. While it runs them it holds the server cvar
+// tsrp_roambots_active at 1 (0 at any other time, and on every other map), and then every bot
+// is a roamer. The plugin's cvars carry the rest:
+//   tsrp_roambots_speed     the walk, in units a second (120: the TS client's walk key,
+//                           cl_movespeedkey 0.3 x cl_forwardspeed 400)
+//   tsrp_roambots_weapons   0: no weapons made for a roamer; 1: armed as usual, still never
+//                           firing. A roamer never buys
+//   tsrp_roambots_pause     the chance, in percent, of a pause before each walk
+// They are read once a second. A cvar that does not exist reads 0, so a server without the
+// plugin has no roamers and nothing here changes how its bots play.
+//
+// A roamer's goals are random waypoints between ROAM_GOAL_NEAREST and ROAM_GOAL_FARTHEST away
+// (any distance when none comes up), never a ladder, lift, jump, crouch or teleport waypoint.
+// The map's waypoints say where it may walk: a roleplay map gives its citizens waypoints only in
+// its public streets and halls (export-map\h9_tsrp_newbyzantium\roamwaypoints.mjs).
+
+bool CBot::IsRoamer() const
+{
+	return RoamNow().bOn;
+}
+
+// A roamer's next schedule: a pause now and then, then a walk to a random goal.
+void CBot::RoamLookForNewTasks()
+{
+	const RoamSettings& roam = RoamNow();
+	const int iSchedule = m_Tasks.GetNewScheduleId();
+
+	m_CurrentLookTask = BOT_LOOK_TASK_LOOK_AROUND;
+
+	if (RANDOM_LONG(1, 100) <= roam.iPause)
+	{
+		// stand and look one way for a while, at eye height
+		const float fYaw = RANDOM_FLOAT(-180.0f, 180.0f) * (3.14159265f / 180.0f);
+		const Vector vLook = pev->origin + pev->view_ofs + Vector(std::cos(fYaw), std::sin(fYaw), 0.0f) * 256.0f;
+
+		AddTask(CBotTask(BOT_TASK_WAIT_AND_FACE_VECTOR, iSchedule, nullptr, 0, RANDOM_FLOAT(ROAM_PAUSE_LEAST, ROAM_PAUSE_MOST), vLook));
+	}
+
+	const int iGoal = RoamGoal();
+
+	if (iGoal != -1)
+		AddTask(CBotTask(BOT_TASK_FIND_PATH, iSchedule, nullptr, iGoal, -1));
+	else
+		AddTask(CBotTask(BOT_TASK_WAIT, iSchedule, nullptr, 0, 2.0f));
+}
+
+// A random waypoint for a roamer to walk to, or -1 when the map has none it may use.
+int CBot::RoamGoal()
+{
+	extern int num_waypoints;
+
+	if (num_waypoints < 1)
+		return -1;
+
+	const int iNotGoal = W_FL_DELETED | W_FL_LADDER | W_FL_LIFT | W_FL_JUMP | W_FL_CROUCH | W_FL_TELEPORT |
+		W_FL_UNREACHABLE | W_FL_AIMING | W_FL_WAIT_FOR_LIFT | W_FL_FLY | W_FL_HUMAN_TOWER | W_FL_OPENS_LATER;
+
+	int iAnyDistance = -1;
+
+	for (int iTry = 0; iTry < ROAM_GOAL_TRIES; iTry++)
+	{
+		const int iWpt = RANDOM_LONG(0, num_waypoints - 1);
+
+		if (waypoints[iWpt].flags & iNotGoal)
+			continue;
+		if (iWpt == m_iCurrentWaypointIndex || m_FailedGoals.IsMember(iWpt))
+			continue;
+
+		const float fDistance = (waypoints[iWpt].origin - pev->origin).Length();
+
+		if (fDistance >= ROAM_GOAL_NEAREST && fDistance <= ROAM_GOAL_FARTHEST)
+			return iWpt;
+
+		if (iAnyDistance == -1)
+			iAnyDistance = iWpt;
+	}
+
+	return iAnyDistance;
+}
