+int CWaypointLocations::bucketOf(const float fCoord, const bool bXY)
+{
+	const float fReach = bXY ? WPT_LOC_REACH_XY : WPT_LOC_REACH_Z;
+	const int iMost = (bXY ? MAX_WPT_LOCATIONS_XY : MAX_WPT_LOCATIONS_Z) - 1;
+	const int iBucket = static_cast<int>(std::floor((fCoord + fReach) / static_cast<float>(WPT_LOC_SIZE)));
+
+	return std::min(std::max(iBucket, 0), iMost);
+}
