# Copy to server.env and edit. Everything here is optional.
#
# A variable left unset is NOT passed to the engine at all, so h9xash_server.sh keeps its own
# default for it. That is deliberate: this file never silently overrides the launcher with an
# empty value. Delete a line rather than blanking it.

# ---- where the server lives ------------------------------------------------------------------
# The unpacked H9XASH-linux-server.zip on the host. Relative paths are relative to this folder.
H9_SERVER_PATH=./server

# The ids that own that folder on the host, so the container can write its logs, its certificate
# lists and the AMX Mod X vault. On Linux:  id -u  and  id -g
PUID=10099
PGID=10099

# ---- the build ---------------------------------------------------------------------------------
# Tags the image. dockerfiles/VERSION holds the build this tree is for; release-prepare.mjs keeps
# it in step. On Linux:  H9_BUILD=$(cat VERSION)
H9_BUILD=dev

# ---- the server --------------------------------------------------------------------------------
# UDP. Change this and the published port in docker-compose.yml follows it.
H9_PORT=27015

H9_HOSTNAME=HAVOC 9 TEAM ELIMINATION
H9_MAP=h9_te_neuropolis

# 128 slots are built in; 64 is the default (docs/PLAYER_LIMIT_128.txt).
H9_MAXPLAYERS=64

# 0 = a public server that heartbeats to the master. 1 = LAN only.
H9_SV_LAN=0

# 1 = teams (docs/RP_TEAMS and the game modes). 0 = free-for-all.
H9_TEAMPLAY=1

# ---- passwords -----------------------------------------------------------------------------------
# A password set here is readable by anything that can run `docker inspect` on the container.
# For rcon, prefer the _FILE form with a Docker secret or a mounted file:
#   H9_RCON_PASSWORD_FILE=/run/secrets/h9_rcon
# H9_RCON_PASSWORD=
# H9_PASSWORD=

# ---- anything else ---------------------------------------------------------------------------------
# Passed to the engine verbatim, after everything above, so these win. Several are fine.
# H9_ARGS=+sv_cheats 0 +mp_timelimit 20

# ---- where the build gets the game -------------------------------------------------------------------
# clone   = from this clone's H9XASH/ (the default): the newest content, and no Git LFS bandwidth
#           is spent at build time because the files are already on disk.
# release = from the published H9XASH-linux-server.zip: no clone and no LFS at all, which is what
#           you want on CI or anywhere a 2 GB checkout is not welcome.
H9_CONTENT=clone

# Where the 32-bit binaries come from. They are build output and are not in git.
# download = the published package (the default).  local = your own H9XASH-linux/ folder.
H9_BINARIES=download

# ---- the P2P helper ----------------------------------------------------------------------------------
# 1 builds the image with Node.js so the helper can run (docs/P2P_JOIN.txt). It only actually runs
# when p2p.ini beside the server says enabled=1. A server with a real forwarded port does not need it.
WITH_P2P=0
