[submodule "SMAK"]
	path = SMAK
	url = https://github.com/deoroot/SMAK
	branch = main
	ignore = dirty
[submodule "EntMod4/uChmViewer"]
	path = EntMod4/uChmViewer
	url = https://github.com/eBookProjects/uChmViewer
[submodule "StripperCS2"]
	path = StripperCS2
	url = https://github.com/Source2ZE/StripperCS2
	branch = master
	ignore = dirty
[submodule "xash3d-fwgs"]
	path = xash3d-fwgs
	url = https://github.com/FWGS/xash3d-fwgs
	ignore = dirty
	# The engine declares 17 nested submodules and most are not initialised here: H9 patches
	# pristine upstream and never builds its vendored opus, vorbis, bzip2 or freetype from a
	# pull. Without this a recursive fetch walks into them and fails on every one, which reads
	# like a broken clone. Updating the engine on purpose still works:
	#     git submodule update --init --recursive xash3d-fwgs
	fetchRecurseSubmodules = false
[submodule "hyperframes"]
	path = hyperframes
	url = https://github.com/heygen-com/hyperframes
	ignore = dirty
	branch = main
[submodule "sdhlt"]
	path = sdhlt
	url = https://github.com/2cwldys/sdhlt
	ignore = dirty
	branch = main
[submodule "ES"]
	path = ES
	url = https://github.com/voidtools/ES.git
	branch = main
	ignore = dirty
