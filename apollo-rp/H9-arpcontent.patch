 		new Num = ARP_FindJobId(Arg,Results,2)
-		if(Num > 1)
+		if(Num > 1 && !H9_JobNamed(Results[0],Arg))
 		{
 			client_print(id,print_console,"Found more than one result for your input (%s).",Arg)
 			return PLUGIN_HANDLED
@@ -1347,7 +1357,7 @@
 	
 	new Results[2],Result
 	
