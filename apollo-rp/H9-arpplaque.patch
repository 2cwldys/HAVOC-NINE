+	for(new Count;Count < g_PlaqueNum;Count++)
+		UTIL_ARP_AddHudItem(id,HUD_QUAT,g_PlaqueText[Count],(Count == g_PlaqueNum - 1 && !g_HudPending) ? 1 : 0,g_PlaqueKind[Count])
+}
