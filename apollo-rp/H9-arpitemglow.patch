 arp_h9_itemicon_max "64"
 arp_h9_itemicon_scale "0.6"
+
+// 1: a pack that has just been dropped glows purple for a few seconds: a point light over it that pulses every second and a half, so that it shows in a dark corner and is easy to find and
+// pick up (a message to the players who can see the pack, no entity). 0: no light, as stock ARP. arp_h9_itemglow_time is how many seconds a pack glows after the drop (0 to 600; 0 gives none),
+// arp_h9_itemglow_radius how far the light reaches (40 to 600 units) and arp_h9_itemglow_color its colour as three numbers, red green blue, each 0 to 255 ("180 60 255" is the purple).
+// A change takes effect at once; a pack that is glowing finishes the time it was given.
+arp_h9_itemglow "1"
+arp_h9_itemglow_time "12"
+arp_h9_itemglow_radius "200"
+arp_h9_itemglow_color "180 60 255"
 
