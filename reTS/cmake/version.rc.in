// Generated by cmake/Version.cmake: the reTS version resource (Explorer: Properties, Details).
// Numeric constants instead of <winres.h>, so llvm-rc and rc.exe both take it without an SDK include.
1 VERSIONINFO
FILEVERSION @RETS_VERSION_MAJOR@,@RETS_VERSION_MINOR@,@RETS_VERSION_PATCH@,@RETS_VERSION_BUILD@
PRODUCTVERSION @RETS_VERSION_MAJOR@,@RETS_VERSION_MINOR@,@RETS_VERSION_PATCH@,@RETS_VERSION_BUILD@
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS 0x40004L
FILETYPE 0x2L
FILESUBTYPE 0x0L
BEGIN
	BLOCK "StringFileInfo"
	BEGIN
		BLOCK "040904b0"
		BEGIN
			VALUE "CompanyName", "goldsrc.net"
			VALUE "FileDescription", "@RETS_RC_DESCRIPTION@"
			VALUE "FileVersion", "@RETS_VERSION_MAJOR@.@RETS_VERSION_MINOR@.@RETS_VERSION_PATCH@.@RETS_VERSION_BUILD@"
			VALUE "InternalName", "@RETS_RC_FILENAME@"
			VALUE "OriginalFilename", "@RETS_RC_FILENAME@"
			VALUE "ProductName", "reTS"
			VALUE "ProductVersion", "@RETS_VERSION_FULL@ (@RETS_VERSION_HASH@)"
		END
	END
	BLOCK "VarFileInfo"
	BEGIN
		VALUE "Translation", 0x409, 1200
	END
END
