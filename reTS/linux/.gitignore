# Don't commit compiled mod libraries
*.so
*.so.*
*.o
*_map.txt

# Allow Half-Life-specific files that would otherwise be ignored
!libSDL2.so
!libSDL2-2.0.so.0
!libSDL2-2.0.so.0.dbg
!vgui.so
!release/vgui.so
# 64-bit client deps: openvgui (ABI-compatible vgui) + a 64-bit SDL2, for amd64 client builds
!release/vgui64.so
!libSDL2-2.0-x64.so.0
# aarch64 client deps: cross-built openvgui + arm64 SDL2, for aarch64 client builds
!release/vgui-aarch64.so
!libSDL2-2.0-arm64.so.0
