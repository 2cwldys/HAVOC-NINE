# havoc9.org on Windows, through Caddy: HTTPS from Let's Encrypt (made and renewed by Caddy
# itself), the site, h9web and the H9 server list. vps\windows\setup.ps1 writes etc\Caddyfile
# from this template on every run ({DOMAIN}, {GAMEHOST}, {ROOT}, {EMAIL_LINE}, {TRUSTED_PROXIES}, {CF_RANGES} filled in); additions of your
# own go in etc\Caddyfile.extra, which it imports and never touches. The same rules as the
# Linux host's nginx (havoc9.org/webclient/DEPLOY.txt section 8), but for the rate limits:
# Caddy has none built in, so h9web's own limits are the only ones here.
{
	storage file_system {ROOT}/data/caddy
	{EMAIL_LINE}
	# behind Cloudflare the visitor's address is CF-Connecting-IP, believed only from Cloudflare's published ranges (setup.ps1
	# writes them into etc\cloudflare-ranges.txt), so h9web's and the list's per-address limits and a game server's enrollment
	# see the visitor, not Cloudflare. A connection from any other address is taken at its own address.
	servers {
		{TRUSTED_PROXIES}
		client_ip_headers CF-Connecting-IP
	}
}

# a part an admin closed (below): 503 with the site's closed.html
(gate_closed) {
	@closed status 403
	handle_response @closed {
		rewrite * /closed.html
		file_server {
			root {ROOT}/site
			status 503
		}
	}
}

{DOMAIN} {
	encode gzip

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Frame-Options "SAMEORIGIN"
		Content-Security-Policy "frame-ancestors 'self'; base-uri 'self'; object-src 'none'"
		Permissions-Policy "camera=(), geolocation=(), payment=(), usb=(), serial=(), hid=(), bluetooth=(), midi=(), display-capture=(), browsing-topics=()"
		-Server
	}

	# never for visitors: dot files and folders, backups, archives, sources, scripts, keys and
	# logs, these notes and the deploy scripts. h9web's and the list's addresses are left alone
	# (a username may end in .sh), and so are the two published downloads and the downloads'
	# file index, which has its own rule below.
	@hidden {
		path_regexp hidden (?i)(/\.|\.(bak[^/]*|orig|rej|old|save|swp|swo|tmp|zip|7z|rar|tar|tgz|sql|sqlite3?|db-wal|db-shm|log|pem|key|crt|p12|pfx|env|sh|ps1|bat|cmd|py|sma|inc|amxx|patch|diff)$|~$)
		not path /.well-known/* /api/* /serverlist/* /downloads/H9XASH.zip /downloads/H9XASH-linux.zip /downloads/files/*
	}
	@notes path /webclient/DEPLOY.txt /deploy/*
	# the downloads' file index (README-WINDOWS.txt step 13 lists what goes in it): a plain
	# listing, and the packages, their reports and the checksums in it. A dot file, a subfolder or
	# any other kind of file there is a 404, and so is a name Windows reads as another file than it
	# looks (NAME~1, name:stream).
	@packages path /downloads/files /downloads/files/*
	@packages_hidden {
		path /downloads/files/*
		not path_regexp (?i)^/downloads/files/([^/.~:][^/~:]*\.(zip|exe|txt))?$
	}
	# H9XASH-Updater's files (stage-h9xash.ps1 publishes them; tools\updater\README_UPDATER.txt):
	# the manifest, and each file under its SHA-256. Without the updater's X-H9-Updater header and
	# User-Agent every address there is a 404, so is any other name, and there is no listing. This
	# keeps the folder out of browsers and search engines; it is not access control.
	@files_hidden {
		path /files/*
		not {
			header X-H9-Updater 1
			header User-Agent H9XASH-Updater/*
			path_regexp ^/files/(hd/)?([0-9a-f]+|manifest\.json)$
		}
	}
	@files_blob path_regexp ^/files/(hd/)?[0-9a-f]+$
	# the parts an admin can close (the admin panel's SITE, h9web/lib/siteflags.js): h9web is asked before every request to them
	# (204 open, 403 closed), as nginx's auth_request does on Linux. While h9web is down they answer 502. The web client's relay
	# is closed by h9web itself.
	@gate_downloads path /downloads/H9XASH.zip /downloads/H9XASH-linux.zip /downloads/files /downloads/files/*
	@gate_webclient {
		path /webclient/*
		not path /webclient/relay
	}
	@api {
		path /api/*
		not path /api/forum/avatar
	}

	# The site is reached through Cloudflare: port 443 is open to every address for {GAMEHOST} (below), so a request that
	# comes straight to this machine for {DOMAIN} is refused first. {CF_RANGES} is Cloudflare's published ranges; the
	# machine's own checks of the site come from itself.
	@direct not remote_ip {CF_RANGES} 127.0.0.1 ::1

	route {
		respond @direct "Use https://{DOMAIN}/" 403
		respond @hidden 404
		respond @notes 404
		respond @files_hidden 404
		respond @packages_hidden 404
		forward_auth @gate_downloads 127.0.0.1:8090 {
			uri /api/site/gate/downloads
			import gate_closed
		}
		forward_auth @gate_webclient 127.0.0.1:8090 {
			uri /api/site/gate/webclient
			import gate_closed
		}
		header /files/manifest.json {
			Cache-Control "no-cache"
			Vary "X-H9-Updater, User-Agent"
		}
		header @files_blob {
			Cache-Control "public, max-age=31536000, immutable"
			Content-Type "application/octet-stream"
			Vary "X-H9-Updater, User-Agent"
		}

		# request bodies: 128 KB for h9web's API (a 128-slot server's presence report), 11 MB for
		# a profile picture, 4 KB for the list
		request_body @api {
			max_size 128KB
		}
		request_body /api/forum/avatar {
			max_size 11MB
		}
		request_body /serverlist/* {
			max_size 4KB
		}

		# h9web: the API and the web client's relay (a WebSocket), from this machine only
		reverse_proxy /api/* 127.0.0.1:8090 {
			header_up X-Real-IP {client_ip}
		}
		reverse_proxy /webclient/relay 127.0.0.1:8090 {
			header_up X-Real-IP {client_ip}
		}

		# the H9 server list (networking.ini's list_bot), its prefix taken off
		handle_path /serverlist/* {
			header Cache-Control "no-cache"
			reverse_proxy 127.0.0.1:8081 {
				header_up X-Real-IP {client_ip}
			}
		}

		# the web client's game files: each address carries the file's hash, so they may be kept
		handle_path /webclient/game/* {
			root * {ROOT}/game
			header Cache-Control "public, max-age=604800"
			file_server {
				precompressed gzip
			}
		}

		# the page, the loader and the lists change with every build
		header /webclient/* Cache-Control "no-cache"

		root * {ROOT}/site
		# the downloads' file index: a listing of that folder only, without its dot files
		file_server @packages {
			browse
			hide .*
		}
		file_server
	}
}

# {GAMEHOST}: the name game servers use for h9_presence_url and heartbeats. It is a DNS-only record with an IPv4 address and
# no IPv6 one (Cloudflare answers every proxied name over IPv6 as well, and a game server's enrollment, which h9web proves by
# asking the server's own address over UDP, must come from its IPv4 address). It carries only what a game server or the game
# calls; every other address answers 404, and its requests never go through Cloudflare, so the address Caddy sees is the
# caller's own.
{GAMEHOST} {
	encode gzip

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		-Server
	}

	@game_api path /api/presence/* /api/community/* /api/rank/* /api/link/* /api/p2p/*

	route {
		request_body @game_api {
			max_size 128KB
		}
		request_body /serverlist/* {
			max_size 4KB
		}
		reverse_proxy @game_api 127.0.0.1:8090 {
			header_up X-Real-IP {client_ip}
		}
		handle_path /serverlist/* {
			header Cache-Control "no-cache"
			reverse_proxy 127.0.0.1:8081 {
				header_up X-Real-IP {client_ip}
			}
		}
		respond "This name is for game servers. The site is https://{DOMAIN}/" 404
	}
}

www.{DOMAIN} {
	redir https://{DOMAIN}{uri} permanent
}

import {ROOT}/etc/Caddyfile.extra
