{
  "mcpServers": {
    "lmstudio": {
      "command": "node",
      "args": ["agents/lmstudio-mcp/index.js"],
      "env": {
        "LM_STUDIO_URL": "http://localhost:1234/v1"
      }
    },
    "smak": {
      "command": "node",
      "args": [
        "SMAK/cli/mcp/server.mjs",
        "--no-run",
        "--models",
        "H9XASH/ts/models",
        "--work",
        "agents/.smak-work"
      ]
    }
  }
}
