extern "C" H9WV_EXPORT int H9WV_ApiVersion( void )
{
	return H9WV_API_VERSION;
}

extern "C" H9WV_EXPORT int H9WV_Runtime( char *buf, int size )
{
	std::wstring folder = RuntimeFolder();
	LPWSTR version = nullptr;

	Copy( buf, size, std::string());

	HRESULT hr = GetAvailableCoreWebView2BrowserVersionString( folder.empty() ? nullptr : folder.c_str(), &version );

	if( FAILED( hr ) || !version )
	{
		CoTaskMemFree( version );
		return 0;
	}

	Copy( buf, size, Narrow( version ) + ( folder.empty() ? "" : " (webview2\\runtime)" ));
	CoTaskMemFree( version );
	return 1;
}

extern "C" H9WV_EXPORT int H9WV_Wine( char *buf, int size )
{
	typedef const char *( __cdecl *wine_get_version_t )( void );
	HMODULE ntdll = GetModuleHandleW( L"ntdll.dll" );
	wine_get_version_t get = ntdll ? ( wine_get_version_t )( void * )GetProcAddress( ntdll, "wine_get_version" ) : nullptr;

	Copy( buf, size, std::string());

	if( !get )
		return 0;

	const char *version = get();
	Copy( buf, size, version ? std::string( version ) : std::string( "unknown" ));
	return 1;
}

extern "C" H9WV_EXPORT void *H9WV_Open( void *parent, const char *url, int flags, h9wv_status_fn status, void *user, char *why, int whysize )
{
	Copy( why, whysize, std::string());

	if( !parent || !IsWindow(( HWND )parent ) || !url || !status )
	{
		Copy( why, whysize, "no game window" );
		return nullptr;
	}

	std::wstring wurl = Widen( url );

	if( !Allowed( wurl.c_str()))
	{
		Copy( why, whysize, "the address is not one the view may open" );
		return nullptr;
	}

	// WebView2 answers through this thread's message loop, which must be a single-threaded apartment
	static bool com = false;

	if( !com )
	{
		HRESULT hr = CoInitializeEx( nullptr, COINIT_APARTMENTTHREADED );

		if( hr == RPC_E_CHANGED_MODE )
		{
			Copy( why, whysize, "the game's thread is not a single-threaded COM apartment" );
			return nullptr;
		}

		if( FAILED( hr ))
		{
			Copy( why, whysize, "COM did not start (0x" + HexResult( hr ) + ")" );
			return nullptr;
		}

		com = true; // kept for the life of the process
	}

	std::wstring runtime = RuntimeFolder();
	std::wstring data = Beside( L"webview2\\data" );

	if( data.empty())
	{
		Copy( why, whysize, "no folder for the browser's files" );
		return nullptr;
	}

	CreateDirectoryW( Beside( L"webview2" ).c_str(), nullptr );

	auto options = Make<CoreWebView2EnvironmentOptions>();

	if( !options )
	{
		Copy( why, whysize, "out of memory" );
		return nullptr;
	}

	if( !ProxyStart())
	{
		Copy( why, whysize, "the view's proxy could not start" );
		return nullptr;
	}

	// every connection through the proxy, loopback's too; WebRTC's UDP only through it, which is never
	std::wstring args = L"--proxy-server=http://127.0.0.1:" + std::to_wstring( g_port )
		+ L" --proxy-bypass-list=<-loopback> --force-webrtc-ip-handling-policy=disable_non_proxied_udp";

	if( flags & H9WV_NOSANDBOX )
		args += L" --no-sandbox";

	if( flags & H9WV_NOGPU )
		args += L" --disable-gpu";

	options->put_AdditionalBrowserArguments( args.c_str());

	options->put_AllowSingleSignOnUsingOSPrimaryAccount( FALSE );
	options->put_TargetCompatibleBrowserVersion( kTargetVersion );

	ComPtr<ICoreWebView2EnvironmentOptions5> options5;
	if( SUCCEEDED( options.As( &options5 )))
		options5->put_EnableTrackingPrevention( TRUE );

	if( flags & H9WV_WINEFIX )
		WineVersionFix();

	auto view = std::make_shared<View>();
	view->parent = ( HWND )parent;
	view->status = status;
	view->user = user;
	view->url = wurl;

	std::weak_ptr<View> weak = view;

	HRESULT hr = CreateCoreWebView2EnvironmentWithOptions( runtime.empty() ? nullptr : runtime.c_str(), data.c_str(), options.Get(),
		Callback<ICoreWebView2CreateCoreWebView2EnvironmentCompletedHandler>(
		[weak]( HRESULT result, ICoreWebView2Environment *env ) -> HRESULT
		{
			auto v = weak.lock();

			if( !v || v->closed )
				return S_OK;

			if( FAILED( result ) || !env )
			{
				if( result == HRESULT_FROM_WIN32( ERROR_FILE_NOT_FOUND ))
					v->Fail( "no WebView2 runtime" );
				else v->Fail( "WebView2 did not start (0x" + HexResult( result ) + ")" );
				return S_OK;
			}

			EnvironmentReady( v, env );
			return S_OK;
		} ).Get());

	if( FAILED( hr ))
	{
		if( hr == HRESULT_FROM_WIN32( ERROR_FILE_NOT_FOUND ))
			Copy( why, whysize, "no WebView2 runtime" );
		else Copy( why, whysize, "WebView2 did not start (0x" + HexResult( hr ) + ")" );
		return nullptr;
	}

	Handle *handle = new( std::nothrow ) Handle;

	if( !handle )
	{
		view->closed = true;
		Copy( why, whysize, "out of memory" );
		return nullptr;
	}

	handle->view = view;
	g_views++;
	return handle;
}

extern "C" H9WV_EXPORT void H9WV_Place( void *handle, int x, int y, int w, int h, int render_w, int render_h, int visible )
{
	Handle *hd = ( Handle * )handle;

	if( !hd || !hd->view )
		return;

	View *v = hd->view.get();
	v->x = x;
	v->y = y;
	v->w = w;
	v->h = h;
	v->rw = render_w;
	v->rh = render_h;
	v->visible = visible != 0;
	v->Apply();
}

extern "C" H9WV_EXPORT void H9WV_Close( void *handle )
{
	Handle *hd = ( Handle * )handle;

	if( !hd )
		return;

	std::shared_ptr<View> v = hd->view;
	delete hd;
	g_views--;

	if( !v )
		return;

	// the keyboard goes back to the game when the page had it
	HWND focus = GetFocus();
	if( focus && focus != v->parent && IsChild( v->parent, focus ))
		SetFocus( v->parent );

	v->closed = true;

	if( v->controller )
		v->controller->Close();

	v->webview.Reset();
	v->controller.Reset();
	v->env.Reset();
}
