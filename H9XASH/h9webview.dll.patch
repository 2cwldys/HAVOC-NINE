/*
h9webview.h - the C interface of h9webview.dll, H9XASH's embedded web page for a server's
splash MOTD (Microsoft Edge WebView2). The engine loads the DLL itself (cl_motd.c, Windows
only) and calls these by name; cl_motd.c keeps its own copy of the numbers below, so a change
here is a change there, with H9WV_API_VERSION raised.

Every call is made on the thread that owns the parent window (the game's main thread), which
pumps its messages every frame: WebView2 answers through that message loop, and so does the
status callback.
*/

#ifndef H9WEBVIEW_H
#define H9WEBVIEW_H

#define H9WV_API_VERSION 1

// what the view tells the engine; detail is ASCII
enum
{
	H9WV_READY = 1,   // the page has loaded: the view may be shown
	H9WV_FAILED,      // the page cannot be shown; detail says why
	H9WV_ESCAPE,      // ESC was pressed in the page
	H9WV_NEWWINDOW,   // the page asked for a new window; detail is its address (nothing was opened)
	H9WV_NAVIGATED,   // the page is going to detail, an address the rules allow
	H9WV_BLOCKED      // a navigation was refused; detail is its address
};

// H9WV_Open's flags
#define H9WV_NOSANDBOX  1 // Wine: --no-sandbox (Chromium's sandbox does not run under Wine)
#define H9WV_NOGPU      2 // Wine: --disable-gpu as well
#define H9WV_WINEFIX    4 // Wine: set HKCU\Software\Wine\AppDefaults\msedgewebview2.exe\Version
                          // to win8 when it is not set (DirectComposition fails at 8.1 and up)

typedef void ( *h9wv_status_fn )( int status, const char *detail, void *user );

// the DLL exports these; anyone else only declares them
#ifdef H9WV_BUILD
#define H9WV_EXPORT __declspec( dllexport )
#else
#define H9WV_EXPORT
#endif

#ifdef __cplusplus
extern "C" {
#endif

// H9WV_API_VERSION
H9WV_EXPORT int H9WV_ApiVersion( void );

// 1 when a WebView2 runtime is there to use, with its version in buf: the Fixed Version runtime
// in <this DLL's folder>\webview2\runtime when that folder has one, else the installed one
H9WV_EXPORT int H9WV_Runtime( char *buf, int size );

// 1 under Wine or Proton (ntdll exports wine_get_version), with Wine's version in buf
H9WV_EXPORT int H9WV_Wine( char *buf, int size );

// Starts a hidden view in parent (an HWND) and sends it to url. NULL, with the reason in why,
// when it cannot start; otherwise status reports what follows. user is handed back as it is.
H9WV_EXPORT void *H9WV_Open( void *parent, const char *url, int flags, h9wv_status_fn status, void *user, char *why, int whysize );

// Where the view sits, in the game's render coordinates: x, y, w, h of a render_w x render_h
// screen, scaled to the parent window's client area. visible 0 hides it.
H9WV_EXPORT void H9WV_Place( void *view, int x, int y, int w, int h, int render_w, int render_h, int visible );

// Takes the view down. No status call follows. The game's window gets the keyboard back when
// the page had it.
H9WV_EXPORT void H9WV_Close( void *view );

#ifdef __cplusplus
}
#endif

#endif // H9WEBVIEW_H

/*
h9webview.cpp - h9webview.dll: H9XASH's embedded web page for a server's splash MOTD

A server running h9_motd.sma with h9_motd "page" names a web page; the engine (cl_motd.c,
engine-h9-motd.patch) shows it inside the MOTD panel through this DLL, which hosts it with
Microsoft Edge WebView2: Chromium, kept up to date by Windows itself on Windows 10 and 11. The
engine loads this DLL by name and calls the five functions of h9webview.h; when any of it is
missing or fails, the engine shows the page's picture or text and an OPEN PAGE button instead.

The view is locked down:
  * a private (InPrivate) session: no cookies, storage or history are kept. The browser's own
    files live in <this DLL's folder>\webview2\data;
  * no host objects and no web messages: the page has no way into the game;
  * downloads cancelled; every permission request denied (camera, microphone, location,
    notifications, clipboard and the rest), screen capture refused; no external programs
    (mailto:, steam: and other schemes); no HTTP or client-certificate sign-in prompts;
  * no developer tools, default context menu, status bar, script dialogs, browser shortcut
    keys, zoom keys, swipe navigation, autofill or password saving; no sign-in with the
    Windows account; tracking prevention strict;
  * every navigation, the first one, every later one, every redirect and every frame's, is
    https to a host name: an IP address, localhost, a single-label name and the usual private
    names (.local, .lan, .internal and the like) are cancelled;
  * a new window is never opened: its address goes to the engine, which shows it in its
    confirm box and opens the system browser only on a click;
  * ESC in the page closes the splash (AcceleratorKeyPressed);
  * every connection the page makes, of any kind, goes through this DLL's own proxy on
    127.0.0.1, which resolves the host itself and connects only to public addresses (the
    address it checked is the one it connects to); plain http and WebRTC's UDP do not
    leave at all.

Under Wine or Proton the engine asks for --no-sandbox (Chromium's sandbox does not run under
Wine), and --disable-gpu when the player wants it, and for Wine's per-application Windows
version for msedgewebview2.exe (win8) when the prefix has none; only with the player's
cl_h9_motd_wine. A Fixed Version WebView2 runtime in <this DLL's folder>\webview2\runtime is
used in place of the installed one, on Windows or under Wine.

Built by build_webview.bat (32-bit, MSVC, static CRT) against the WebView2 SDK in ..\deps, with
WebView2Loader linked in statically: the DLL needs nothing but Windows and the WebView2 runtime.
*/

