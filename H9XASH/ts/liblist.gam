game "HAVOC 9"
url_info "https://havoc9.org/downloads"
url_dl "https://havoc9.org/downloads"
version "3.0"
size ""
svonly "0"

// Unverified experiment, not an established fix: community reports say a Steam-validated
// server rejects a non-Steam client's ticket (what "STEAM validation rejected" means, see
// docs\ENGINE_DIFFERENTIALS.txt) and that this field is the lever for it. sv_lan does NOT
// help here -- it is for genuine LAN-only hosting and rejects a real remote client's ticket
// even harder. Nobody has tried this against a live Xash client yet.
secure "0"

cldll "cl_dlls\client.dll"
hlversion "1110"
type "multiplayer_only"
nomodels "0"
mpentity "info_player_deathmatch"
icon "h9_logo_32"
edicts "4098"

//gamedll "dlls\mp.dll"
gamedll "addons\metamod\dlls\metamod.dll"

// I've never know this to actually let you specify a file other then dlls/ts_i386.so
// If you want a port to a different architecture, get on the forums and send a PM to Vino.
// Note that the file ts_i386.so is just a symlink to ts_i686.so, 3.0 was not released with a 386 binary.
gamedll_linux "dlls/ts_i386.so"
