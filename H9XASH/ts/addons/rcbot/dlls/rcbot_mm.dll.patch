+	if (m_pRoamAttacker == nullptr || m_pRoamAttacker->free || !(m_pRoamAttacker->v.flags & FL_CLIENT) ||
+		GETPLAYERUSERID(m_pRoamAttacker) != m_iRoamAttackerId)
