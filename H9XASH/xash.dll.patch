+		return false;
+	}
+
+	AVI_OpenVideo( cin_state, fullpath, false, false );
+	if( !( AVI_GetVideoInfo( cin_state, &gameui.menubg_xres, &gameui.menubg_yres, &gameui.menubg_length )))
