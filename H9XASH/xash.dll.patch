+// the link gone here: a new random id, written and set (h9_unlink, or the link's site says it is gone)
+static void H9L_DropLink( void )
+{
+	memset( &h9l.rec, 0, sizeof( h9l.rec ));
+	H9L_NewId( h9l.rec.id );
+	if( !H9L_Write( ))
+		Con_Printf( S_WARN "user_id.ini could not be written: the new id holds for this session only\n" );
+	H9L_Apply();
+	H9L_Resalt();
+}
+
+static void H9L_StatusAnswer( const char *url, qboolean success, const byte *data, size_t size, void *userdata )
+{
+	char body[512], status[32], account[32];
+
+	h9l.status_asking = false;
+	if( !H9L_Body( success, data, size, body, sizeof( body )) || !H9L_Json( body, "status", status, sizeof( status )))
+		return; // no answer: the link stands
+	if( !H9L_Linked( &h9l.rec ) || Q_strcmp( h9l.rec.token, h9l.status_token ))
+		return; // linked again, or unlinked, while it asked
+	if( !url || Q_strncmp( url, h9l.rec.site, Q_strlen( h9l.rec.site )) || url[Q_strlen( h9l.rec.site )] != '/' )
+		return; // only the link's own site can end it
+
+	if( !Q_strcmp( status, "unlinked" ))
+	{
+		Con_Printf( "H9 LINK: %s no longer lists this game as linked to %s (REVOKE on the ACCOUNT page, or the account's player id was reset). "
+			"It has a new id; link it again from the main menu.\n", H9L_SiteName( h9l.rec.site ), h9l.rec.account );
+		H9L_DropLink();
+		if( h9l.flow == H9LF_LINKED )
+			H9L_SetFlow( H9LF_IDLE );
+	}
+	else if( !Q_strcmp( status, "linked" ) && H9L_Json( body, "account", account, sizeof( account )) && H9L_IsAccount( account ) && Q_strcmp( account, h9l.rec.account ))
+	{
+		// the account was renamed
+		Q_strncpy( h9l.rec.account, account, sizeof( h9l.rec.account ));
+		H9L_Write( );
+		H9L_Apply( );
+	}
+}
+
+// a try that got no answer: again in a minute, while the menu is up
+static void H9L_AdoptLater( void )
+{
+	h9l.adopt_asking = false;
+	h9l.adopt_next = host.realtime + 60.0;
+}
+
+static void H9L_AdoptAnswer( const char *url, qboolean success, const byte *data, size_t size, void *userdata )
+{
+	char body[512], status[32], account[32], token[48], reason[32];
+
+	if( (int)(intptr_t)userdata != h9l.adopt_gen || !h9l.adopt_asking )
+		return;
+	if( !H9L_Body( success, data, size, body, sizeof( body )) || !H9L_Json( body, "status", status, sizeof( status )))
+	{
+		H9L_AdoptLater();
+		return;
+	}
+	h9l.adopt_asking = false;
+
+	if( !Q_strcmp( status, "linked" ) && H9L_Json( body, "account", account, sizeof( account )) && H9L_IsAccount( account )
+		&& H9L_Json( body, "token", token, sizeof( token )) && H9L_IsToken( token ))
+	{
+		h9l.adopt_done = true;
+		if( H9L_Linked( &h9l.rec ) || Q_strcmp( h9l.rec.id, h9l.adopt_id ))
+			return; // linked or changed meanwhile
+		Q_strncpy( h9l.rec.linked, h9l.rec.id, sizeof( h9l.rec.linked ));
+		Q_strncpy( h9l.rec.account, account, sizeof( h9l.rec.account ));
+		Q_strncpy( h9l.rec.token, token, sizeof( h9l.rec.token ));
+		Q_strncpy( h9l.rec.site, h9l.adopt_site, sizeof( h9l.rec.site ));
+		if( !H9L_Write( ))
+			Con_Printf( S_WARN "user_id.ini could not be written: the link holds for this session only\n" );
+		H9L_Apply();
+		h9l.status_done = true; // nothing to ask this session: the link is new
+		Con_Printf( "H9 LINK: this game's id is %s account %s's: the game is linked to it\n", H9L_SiteName( h9l.adopt_site ), account );
+		return;
+	}
+	if( !Q_strcmp( status, "unknown" ))
+	{
+		h9l.adopt_done = true; // an id of this install's own: nothing to say
+		return;
+	}
+	if( !Q_strcmp( status, "refused" ) && H9L_Json( body, "reason", reason, sizeof( reason )) && Q_strcmp( reason, "stale" ))
+	{
+		h9l.adopt_done = true;
+		if( !Q_strcmp( reason, "second_device" ))
+			Con_Printf( "H9 LINK: this game's id is an account's on %s, but its id is bound to another device there: an admin may allow this one\n", H9L_SiteName( h9l.adopt_site ));
+		else if( !Q_strcmp( reason, "suspended" ))
+			Con_Printf( "H9 LINK: this game's id is a suspended account's on %s: not linked\n", H9L_SiteName( h9l.adopt_site ));
+		else Con_Printf( "H9 LINK: %s did not take this game's proof of its id (%s): not linked\n", H9L_SiteName( h9l.adopt_site ), reason );
+		return;
+	}
+	H9L_AdoptLater(); // busy, a used nonce, or an answer this game does not know
+}
+
+static void H9L_AdoptNonceAnswer( const char *url, qboolean success, const byte *data, size_t size, void *userdata )
+{
+	char body[256], status[32], nonce[40], key[33], devmask[33], proof[65], path[384];
+	uint8_t device[16], mac[32];
+
+	if( (int)(intptr_t)userdata != h9l.adopt_gen || !h9l.adopt_asking )
+		return;
+	if( !H9L_Body( success, data, size, body, sizeof( body )) || !H9L_Json( body, "status", status, sizeof( status ))
+		|| Q_strcmp( status, "ok" ) || !H9L_Json( body, "nonce", nonce, sizeof( nonce )) || !H9_IsHex( nonce, 32 ))
+	{
+		H9L_AdoptLater();
+		return;
+	}
+	if( H9L_Linked( &h9l.rec ) || !H9_IsHex( h9l.rec.id, 32 ) || !H9L_DeviceRead( device ))
+	{
+		h9l.adopt_asking = false;
+		h9l.adopt_done = true;
+		return;
+	}
+
+	H9_HmacSha256( (const uint8_t *)h9l.rec.id, 32, (const uint8_t *)"h9adopt-key1", 12, mac );
+	H9_ToHex( mac, 16, key );
+	H9_IdProof( h9l.rec.id, device, nonce, "h9link-adopt", devmask, proof );
+	memset( device, 0, sizeof( device ));
+	memset( mac, 0, sizeof( mac ));
+	Q_strncpy( h9l.adopt_id, h9l.rec.id, sizeof( h9l.adopt_id ));
+
+	Q_snprintf( path, sizeof( path ), "/api/link/adopt?v=1&key=%s&nonce=%s&devmask=%s&proof=%s&os=%s",
+		key, nonce, devmask, proof, H9L_UnderWine( ) ? "wine" : "windows" );
+	if( !H9L_GetAt( h9l.adopt_site, path, H9L_AdoptAnswer, h9l.adopt_gen ))
+		H9L_AdoptLater();
+}
+
+static void H9L_AdoptStart( void )
+{
+	uint8_t device[16];
+
+	h9l.adopt_started = true;
+	if( !H9L_DeviceRead( device ))
+	{
+		h9l.adopt_done = true; // no device id: no proof to make
+		return;
+	}
+	memset( device, 0, sizeof( device ));
+	Q_strncpy( h9l.adopt_site, H9L_Site( ), sizeof( h9l.adopt_site ));
+	h9l.adopt_asking = true;
+	h9l.adopt_gen++;
+	if( !H9L_GetAt( h9l.adopt_site, "/api/link/adopt/nonce?v=1", H9L_AdoptNonceAnswer, h9l.adopt_gen ))
+		H9L_AdoptLater();
+}
+
+/*
+==============================================================================
+
+	THE COMMANDS
+
+==============================================================================
+*/
+
+/*
+=================
+H9L_Link_f
+
+h9_link [open|cancel]
+=================
+*/
+static void H9L_Link_f( void )
+{
+	const qboolean mine = Cmd_CurrentCommandIsPrivileged();
+	const char *arg = Cmd_Argc() > 1 ? Cmd_Argv( 1 ) : "";
+
+	if( !h9l.loaded )
+	{
+		Con_Printf( "H9 LINK: this game has no id store (user_id.ini) to link\n" );
+		return;
+	}
+
+	if( arg[0] )
+	{
+		if( !mine )
+			return; // opening the browser and dropping the code are the player's alone
+
+		if( !Q_stricmp( arg, "open" ))
+		{
+			char url[256];
+
+			if( h9l.flow != H9LF_WAITING )
+			{
+				Con_Printf( "H9 LINK: no code is up: h9_link first\n" );
+				return;
+			}
+			Q_snprintf( url, sizeof( url ), "%s/link/?code=%s", h9l.flow_site, h9l.user_code );
+			Con_Printf( "H9 LINK: opening %s in the web browser\n", url );
+			Platform_ShellExecute( url, NULL );
+			h9l.panel_up = false;
+		}
+		else if( !Q_stricmp( arg, "cancel" ))
+		{
+			if( h9l.flow == H9LF_ASKING || h9l.flow == H9LF_WAITING )
+				Con_Printf( "H9 LINK: the code is dropped\n" );
+			h9l.generation++;
+			h9l.asking = false;
+			h9l.device_code[0] = 0;
+			H9L_SetText( "%s", "" );
+			H9L_SetFlow( H9LF_IDLE );
+		}
+		else Con_Printf( S_USAGE "h9_link [open|cancel]\n" );
+		return;
+	}
+
+	if( H9L_Linked( &h9l.rec ))
+	{
+		Con_Printf( "H9 LINK: this game is linked to %s account %s already. Unlink it first (Unlink your Account in the main menu, or h9_unlink).\n", H9L_SiteName( h9l.rec.site ), h9l.rec.account );
+		return;
+	}
+
+	// a code that is up already is shown again
+	if( h9l.flow == H9LF_ASKING || h9l.flow == H9LF_WAITING )
+	{
+		if( h9l.flow == H9LF_WAITING )
+		{
+			Con_Printf( "H9 LINK: your code is %s (h9_link open opens the page)\n", h9l.user_code );
+			if( cls.state == ca_active && cls.key_dest == key_game )
+			{
+				Key_ClearStates();
+				memset( h9l.eat, 0, sizeof( h9l.eat ));
+				h9l.panel_up = true;
+			}
+		}
+		return;
+	}
+
+	if( !mine )
+	{
+		int i, recent = 0;
+
+		// a server's: only in a game, and only so often
+		if( cls.state != ca_active || cls.demoplayback )
+			return;
+		for( i = 0; i < H9L_SERVER_BURST; i++ )
+		{
+			if( h9l.server_starts[i] > 0.0 && host.realtime - h9l.server_starts[i] < H9L_SERVER_WINDOW )
+				recent++;
+		}
+		if( recent >= H9L_SERVER_BURST )
+		{
+			Con_Printf( "H9 LINK: the server asked for another code too soon: type h9_link in the console instead\n" );
+			return;
+		}
+		h9l.server_starts[h9l.next_server_start] = host.realtime;
+		h9l.next_server_start = ( h9l.next_server_start + 1 ) % H9L_SERVER_BURST;
+	}
+
+	H9L_Start();
+}
+
+/*
+=================
+H9L_Unlink_f
+
+h9_unlink: the player's alone (a privileged command)
+=================
+*/
+static void H9L_Unlink_f( void )
+{
+	char path[96], account[32], site[64];
+
+	if( !h9l.loaded )
+		return;
+	if( !H9L_Linked( &h9l.rec ))
+	{
+		Con_Printf( "H9 LINK: this game is not linked to an account\n" );
+		return;
+	}
+
+	// the link's own site is told, and whether it hears does not matter here
+	Q_snprintf( path, sizeof( path ), "/api/link/unlink?token=%s", h9l.rec.token );
+	H9L_GetAt( h9l.rec.site, path, H9L_Ignore, 0 );
+
+	Q_strncpy( account, h9l.rec.account, sizeof( account ));
+	Q_strncpy( site, h9l.rec.site, sizeof( site ));
+	H9L_DropLink();
+	if( h9l.flow == H9LF_LINKED )
+		H9L_SetFlow( H9LF_IDLE );
+	Con_Printf( "H9 LINK: this game is no longer linked to %s account %s. It has a new id.\n", H9L_SiteName( site ), account );
+}
+
+/*
+==============================================================================
+
+	THE PANEL IN A GAME (a panel of cl_motd.c's kind)
+
+==============================================================================
+*/
+
+static qboolean H9L_Active( void )
+{
+	return h9l.panel_up && h9l.flow == H9LF_WAITING && cls.state == ca_active && cls.key_dest == key_game;
+}
+
+static void H9L_Open_Page( void )
+{
+	Cbuf_AddText( "h9_link open\n" );
+	h9l.panel_up = false;
+}
+
+static qboolean H9L_KeyEvent( int key, qboolean down )
+{
+	if( key < 0 || key >= (int)ARRAYSIZE( h9l.eat ))
+		return false;
+
+	if( !down )
+	{
+		if( !h9l.eat[key] )
+			return false;
+		h9l.eat[key] = false;
+		return true;
+	}
+
+	// the console stays within reach
+	if( !H9L_Active( ) || key == '`' || key == '~' )
+		return false;
+
+	h9l.eat[key] = true;
+
+	switch( key )
+	{
+	case 'o':
+	case 'O':
+	case K_ENTER:
+	case K_KP_ENTER:
+		H9L_Open_Page();
+		break;
+	case K_ESCAPE:
+		h9l.panel_up = false;
+		break;
+	default:
+		break;
+	}
+	return true;
+}
+
+static qboolean H9L_MouseEvent( int key, qboolean down )
+{
+	int mx, my;
+
+	if( key < K_MOUSE1 || key > K_MOUSE5 )
+		return false;
+
+	if( !down )
+	{
+		if( !h9l.eat[key] )
+			return false;
+		h9l.eat[key] = false;
+		return true;
+	}
+
+	if( !H9L_Active( ))
+		return false;
+
+	h9l.eat[key] = true;
+	if( key != K_MOUSE1 )
+		return true;
+
+	Platform_GetMousePos( &mx, &my );
+	if( H9UI_Hit( &h9l.btn[H9L_BTN_OPEN], mx, my ))
+		H9L_Open_Page();
+	else if( H9UI_Hit( &h9l.btn[H9L_BTN_CLOSE], mx, my ))
+		h9l.panel_up = false;
+	return true;
+}
+
+// Asks the link's own site whether the link still stands (GET /api/link/status), one ask at a time
+// and only while cl_h9_site points to that site: a link made on the local test site is left alone on
+// havoc9.org, said in the console when say.
+static void H9L_StatusCheck( qboolean say )
+{
+	char path[96];
+
+	if( !H9L_Linked( &h9l.rec ) || h9l.status_asking )
+		return;
+	if( Q_strcmp( h9l.rec.site, H9L_Site( )))
+	{
+		if( say )
+			Con_Printf( "H9 LINK: this game is linked on %s, and cl_h9_site points elsewhere: the link is kept, and not checked this time\n",
+				H9L_SiteName( h9l.rec.site ));
+		return;
+	}
+	Q_strncpy( h9l.status_token, h9l.rec.token, sizeof( h9l.status_token ));
+	Q_snprintf( path, sizeof( path ), "/api/link/status?token=%s", h9l.rec.token );
+	h9l.status_asking = H9L_GetAt( h9l.rec.site, path, H9L_StatusAnswer, 0 );
+}
+
+static void H9L_Frame( void )
+{
+	if( !h9l.loaded )
+		return;
+
+	H9L_WatchFile();
+
+	// the site in use, said a moment after start (configs have run) and whenever cl_h9_site changes
+	if( host.realtime - h9l.started_at > 2.0 )
+	{
+		convar_t *cv = Cvar_FindVar( "cl_h9_site" );
+		const char *value = cv ? cv->string : "";
+
+		if( !h9l.site_said || Q_strcmp( h9l.site_value, value ))
+		{
+			char site[64];
+			const int kind = H9L_SiteOf( value, site, sizeof( site ));
+
+			h9l.site_said = true;
+			Q_strncpy( h9l.site_value, value, sizeof( h9l.site_value ));
+			if( kind == 1 )
+				Con_Printf( "H9 SITE: %s, the local test site cl_h9_site names\n", site );
+			else if( kind == 0 )
+				Con_Printf( "H9 SITE: %s\n", H9L_SITE );
+			else if( kind == -2 )
+				Con_Printf( "H9 SITE: cl_h9_site \"%s\" is cut short (the console takes // for a comment): write cl_h9_site 127.0.0.1:<port>. Using %s\n", value, H9L_SITE );
+			else Con_Printf( "H9 SITE: cl_h9_site \"%s\" is not a local test site (127.0.0.1:<port> or localhost:<port>): using %s\n", value, H9L_SITE );
+		}
+	}
+
+	// the site the menu names: the code's while one is up, else the link's, else cl_h9_site's
+	if( h9l.flow != H9LF_ASKING && h9l.flow != H9LF_WAITING )
+	{
+		const char *name = H9L_SiteName( H9L_Linked( &h9l.rec ) ? h9l.rec.site : H9L_Site( ));
+
+		if( Q_strcmp( cl_h9link_site.string, name ))
+			Cvar_DirectFullSet( &cl_h9link_site, name, 0 );
+	}
+
+	// does the link still stand? Once a start, and in a game a moment after each map starts and every
+	// H9L_STATUS_EVERY seconds (H9L_StatusCheck)
+	if( !h9l.status_done && host.realtime - h9l.started_at > H9L_STATUS_DELAY )
+	{
+		h9l.status_done = true;
+		H9L_StatusCheck( true );
+	}
+	else if( h9l.status_done && cls.state == ca_active && H9L_Linked( &h9l.rec ) && host.realtime >= h9l.status_next )
+	{
+		h9l.status_next = host.realtime + H9L_STATUS_EVERY;
+		H9L_StatusCheck( false );
+	}
+
+	// a record with an id and no link asks whether its id is an account's: once a start, ten
+	// seconds in, and while the main menu is up; once for each id and site, or again a minute after
+	// a try that got no answer. Another id or site (cl_h9_site changed) is asked at once.
+	if( !H9L_Linked( &h9l.rec ) && h9l.flow != H9LF_ASKING && h9l.flow != H9LF_WAITING && !h9l.adopt_asking
+		&& host.realtime - h9l.started_at > H9L_STATUS_DELAY )
+	{
+		char want[128];
+
+		Q_snprintf( want, sizeof( want ), "%s|%s", h9l.rec.id, H9L_Site( ));
+		if( Q_strcmp( want, h9l.adopt_for ))
+		{
+			Q_strncpy( h9l.adopt_for, want, sizeof( h9l.adopt_for ));
+			h9l.adopt_done = false;
+			h9l.adopt_next = 0.0;
+		}
+		if( !h9l.adopt_done && host.realtime >= h9l.adopt_next && ( !h9l.adopt_started || cls.key_dest == key_menu ))
+			H9L_AdoptStart();
+	}
+
+	if( h9l.flow != H9LF_WAITING )
+		return;
+
+	if( host.realtime >= h9l.expires_at )
+	{
+		H9L_Fail( "The code ran out. Link again for a new one." );
+		return;
+	}
+	H9L_TimeText();
+
+	if( !h9l.asking && host.realtime >= h9l.next_poll_at )
+	{
+		char path[96];
+
+		Q_snprintf( path, sizeof( path ), "/api/link/poll?code=%s", h9l.device_code );
+		h9l.asking = true;
+		if( !H9L_GetAt( h9l.flow_site, path, H9L_PollAnswer, h9l.generation ))
+		{
+			h9l.asking = false;
+			h9l.next_poll_at = host.realtime + h9l.interval;
+		}
+	}
+}
+
+// one line at the top of the screen: the code while it waits, a result for a few seconds
+static void H9L_Notice( cl_font_t *font, const char *s )
+{
+	int W = refState.width, lh = font->charHeight, pad = Q_max( 4, lh / 3 );
+	int w = Q_min( W - pad * 4, H9UI_Width( font, s, Q_strlen( s )) + pad * 2 );
+	int x = ( W - w ) / 2, y = lh * 3;
+
+	H9UI_Fill( x, y, w, lh + pad, 14, 8, 20, 220 );
+	H9UI_Border( x, y, w, lh + pad, 1 );
+	H9UI_Line( font, x + pad, y + pad / 2, w - pad * 2, s, h9ui_white );
+}
+
+static void H9L_Draw( void )
+{
+	char line[200];
+	cl_font_t *font;
+	int W, H, lh, pad, bh, pw, ph, px, py, y, mx, my, ow, cw;
+
+	if( cls.state != ca_active || cls.key_dest != key_game )
+		return;
+
+	font = Con_GetCurFont();
+	if( !font || !font->valid || font->charHeight <= 0 )
+		return;
+
+	if( !H9L_Active( ))
+	{
+		if( h9l.flow == H9LF_WAITING )
+		{
+			int left = Q_max( 0, (int)( h9l.expires_at - host.realtime + 0.999 ));
+
+			Q_snprintf( line, sizeof( line ), "%s/link -- your code: %s (%d:%02d left). h9_link shows it again.", H9L_SiteName( h9l.flow_site ), h9l.user_code, left / 60, left % 60 );
+			H9L_Notice( font, line );
+		}
+		else if(( h9l.flow == H9LF_LINKED || h9l.flow == H9LF_FAILED ) && host.realtime < h9l.notice_until )
+			H9L_Notice( font, h9l.text );
+		else return;
+
+		ref.dllFuncs.Color4ub( 255, 255, 255, 255 );
+		ref.dllFuncs.GL_SetRenderMode( kRenderNormal );
+		return;
+	}
+
+	W = refState.width;
+	H = refState.height;
+	lh = font->charHeight;
+	pad = Q_max( 6, lh / 2 );
+	bh = lh + pad;
+	pw = Q_min( W - pad * 4, H9UI_Width( font, "n", 1 ) * 66 + pad * 2 );
+	ph = pad + lh * 8 + pad + bh + pad;
+	px = ( W - pw ) / 2;
+	py = ( H - ph ) / 3;
+
+	memset( h9l.btn, 0, sizeof( h9l.btn ));
+	Platform_GetMousePos( &mx, &my );
+
+	H9UI_Fill( 0, 0, W, H, 0, 0, 0, 120 );
+	H9UI_Fill( px, py, pw, ph, 14, 8, 20, 245 );
+	H9UI_Border( px, py, pw, ph, Q_max( 1, lh / 12 ));
+
+	y = py + pad;
+	Q_snprintf( line, sizeof( line ), "Link this game to your account on %s", H9L_SiteName( h9l.flow_site ));
+	H9UI_Line( font, px + pad, y, pw - pad * 2, line, h9ui_light );
+	y += lh * 2;
+	Q_snprintf( line, sizeof( line ), "Your code:   %s", h9l.user_code );
+	H9UI_Line( font, px + pad, y, pw - pad * 2, line, h9ui_white );
+	y += lh * 2;
+	Q_snprintf( line, sizeof( line ), "1. OPEN PAGE opens %s/link in your web browser.", H9L_SiteName( h9l.flow_site ));
+	H9UI_Line( font, px + pad, y, pw - pad * 2, line, h9ui_soft );
+	y += lh;
+	H9UI_Line( font, px + pad, y, pw - pad * 2, "2. Sign in there, and check that it shows this code.", h9ui_soft );
+	y += lh;
+	H9UI_Line( font, px + pad, y, pw - pad * 2, "3. Press LINK. This game then plays as your account.", h9ui_soft );
+	y += lh;
+	H9UI_Line( font, px + pad, y, pw - pad * 2, h9l.text, h9ui_soft );
+	y += lh + pad;
+
+	cw = H9UI_Width( font, "CLOSE (ESC)", 11 ) + pad * 2;
+	ow = H9UI_Width( font, "OPEN PAGE (O)", 13 ) + pad * 2;
+	H9UI_Button( font, &h9l.btn[H9L_BTN_CLOSE], px + pw - pad - cw, y, cw, bh, "CLOSE (ESC)", mx, my );
+	H9UI_Button( font, &h9l.btn[H9L_BTN_OPEN], px + pw - pad - cw - pad - ow, y, ow, bh, "OPEN PAGE (O)", mx, my );
+
+	if( !host.mouse_visible )
+		H9UI_Cursor( mx, my, Q_max( 1, H / 540 ));
+
+	ref.dllFuncs.Color4ub( 255, 255, 255, 255 );
+	ref.dllFuncs.GL_SetRenderMode( kRenderNormal );
+}
+
+static void H9L_Reset( qboolean connection )
+{
+	// a new map or a disconnect takes the panel down; the code goes on waiting
+	h9l.panel_up = false;
+	memset( h9l.eat, 0, sizeof( h9l.eat ));
+	// the link's status asked again a moment into the next map, or as soon as the next server's game is up
+	h9l.status_next = connection ? 0.0 : host.realtime + H9L_STATUS_MAP;
+}
+
+static const h9ui_panel_t h9l_panel =
+{
+	H9L_Active,
+	H9L_KeyEvent,
+	H9L_MouseEvent,
+	H9L_Frame,
+	H9L_Draw,
+	H9L_Reset,
+};
+
+/*
+==============
+CL_H9Link_Init
+
+after CL_InitLocal registered cl_h9_userid, before any config runs
+==============
+*/
+void CL_H9Link_Init( void )
+{
+	Cvar_RegisterVariable( &cl_h9lnk );
+	Cvar_RegisterVariable( &cl_h9link_account );
+	Cvar_RegisterVariable( &cl_h9link_flow );
+	Cvar_RegisterVariable( &cl_h9link_code );
+	Cvar_RegisterVariable( &cl_h9link_text );
+	Cvar_RegisterVariable( &cl_h9link_site );
+
+	// not restricted: a server may send it (h9_link.sma's .link), and it only puts up a code
+	Cmd_AddCommand( "h9_link", H9L_Link_f, "H9: link this game to your havoc9.org account (a code to approve on havoc9.org/link); h9_link open | cancel" );
+	Cmd_AddRestrictedCommand( "h9_unlink", H9L_Unlink_f, "H9: unlink this game from its havoc9.org account; it gets a new id" );
+
+	// the id is the store's: config.cfg no longer keeps it, and no config or console sets it
+	ClearBits( cl_h9_userid.flags, FCVAR_ARCHIVE );
+	SetBits( cl_h9_userid.flags, FCVAR_READ_ONLY );
+
+	h9l.flow = H9LF_IDLE;
+	h9l.started_at = host.realtime;
+	H9L_Load();
+	H9UI_AddPanel( &h9l_panel );
+}
+
+#endif // !H9_LINK_SELFTEST
+
+#else // !XASH_WIN32 || XASH_EMSCRIPTEN
+
+void CL_H9Link_Init( void )
+{
+}
+
+#endif
diff --git a/engine/client/cl_h9listen.c b/engine/client/cl_h9listen.c
new file mode 100644
index 00000000..27324d17
--- /dev/null
+++ b/engine/client/cl_h9listen.c
@@ -0,0 +1,200 @@
+/*
+cl_h9listen.c - H9: presence for a game's own listen server (Create Game; docs/H9_PRESENCE.txt, section 8a)
+Copyright (C) 2026 HAVOC 9
+
+This program is free software: you can redistribute it and/or modify
+it under the terms of the GNU General Public License as published by
+the Free Software Foundation, either version 3 of the License, or
+(at your option) any later version.
+
+This program is distributed in the hope that it will be useful,
+but WITHOUT ANY WARRANTY; without even the implied warranty of
+MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
+GNU General Public License for more details.
+
+The player who starts a listen server (Create Game) joins it over "loopback", which has no address.
+h9_clientid (cl_main.c) is salted with the address a client joins, and the ID proof (cl_idproof.c)
+signs that address, so on its own listen server a player had neither an h9_clientid h9web knows nor
+a proof. h9_presence on a listen server tells its own player the address it reports as:
+
+  h9_idlisten <a.b.c.d:port>            from now on this connection's h9_clientid is salted with
+                                        that address, as a player joining it from elsewhere has it,
+                                        and the server is told at once (setinfo)
+  h9_idlisten <a.b.c.d:port> <nonce>    the same, then the ID proof's answer with S = that address,
+                                        "h9_idproof <nonce> <devmask> <proof>" as cl_idproof.c sends
+
+Only a loopback connection is answered, never a demo: a server elsewhere can never choose the address
+a player's h9_clientid is salted with or the proof signs. The address is written back in its one
+form (no leading zeros), the form h9web keys servers by. The userinfo key _h9idl is "1" in a game
+that answers h9_idlisten, which is what makes a listen server's h9_presence (1.4) use it in place of
+h9_idchallenge (a key starting with "_" is not sent to other players).
+
+The hashing is cl_idproof.c's own, built into this file a second time (its H9_IDPROOF_SELFTEST part),
+and the device id is read from the same device_id.ini, which cl_idproof.c makes. An answer goes at
+most four times a minute. The browser build has none of this: its players are vouched for by h9web's
+relay.
+*/
+
+#include "common.h"
+#include "client.h"
+#include "net_ws.h"
+
+#if !XASH_EMSCRIPTEN
+
+#define H9_IDPROOF_SELFTEST
+#include "cl_idproof.c"
+#undef H9_IDPROOF_SELFTEST
+
+static CVAR_DEFINE( cl_h9idl, "_h9idl", "0", FCVAR_USERINFO|FCVAR_PRIVILEGED, "H9: 1 in a game that answers its own listen server's h9_idlisten (set by the engine, cl_h9listen.c)" );
+
+static uint8_t h9l_device[16];
+static qboolean h9l_device_ok;
+static double h9l_answered[4]; // when the last four answers went, a ring
+static int h9l_next;
+
+// device_id.ini in the root folder, as cl_idproof.c keeps it; read on first need, so a first run,
+// which makes the file after this file's init, finds it too
+static qboolean H9L_Device( void )
+{
+	char root[MAX_SYSPATH], path[MAX_SYSPATH], text[512];
+	const char *id;
+	FILE *f;
+	size_t n;
+	int i;
+
+	if( h9l_device_ok )
+		return true;
+	if( !g_fsapi.GetRootDirectory( root, sizeof( root )))
+		return false;
+	Q_snprintf( path, sizeof( path ), "%s/device_id.ini", root );
+
+	f = fopen( path, "rb" );
+	if( !f )
+		return false;
+	n = fread( text, 1, sizeof( text ) - 1, f );
+	fclose( f );
+	text[n] = 0;
+	id = Q_strstr( text, "id=" );
+	if( !id )
+		return false;
+	id += 3;
+	for( i = 0; i < 16; i++ )
+	{
+		int hi = H9_HexValue( id[i * 2] ), lo = H9_HexValue( id[i * 2 + 1] );
+
+		if( hi < 0 || lo < 0 )
+			return false;
+		h9l_device[i] = (uint8_t)( hi * 16 + lo );
+	}
+	h9l_device_ok = true;
+	return true;
+}
+
+// "a.b.c.d:port", digits only, each part in range; out is the same address in its one form
+static qboolean H9L_Address( const char *s, char *out, size_t size )
+{
+	int part[5] = { 0 }, digits = 0, n = 0;
+	const char *p;
+
+	for( p = s; ; p++ )
+	{
+		if( *p >= '0' && *p <= '9' )
+		{
+			if( ++digits > 5 )
+				return false;
+			part[n] = part[n] * 10 + ( *p - '0' );
+			continue;
+		}
+		if( !digits )
+			return false;
+		if(( n < 3 && *p == '.' ) || ( n == 3 && *p == ':' ))
+		{
+			n++;
+			digits = 0;
+			continue;
+		}
+		if( n == 4 && *p == 0 )
+			break;
+		return false;
+	}
+
+	for( n = 0; n < 4; n++ )
+	{
+		if( part[n] > 255 )
+			return false;
+	}
+	if( part[4] < 1 || part[4] > 65535 )
+		return false;
+
+	Q_snprintf( out, size, "%d.%d.%d.%d:%d", part[0], part[1], part[2], part[3], part[4] );
+	return true;
+}
+
+/*
+==============
+CL_H9IdListen_f
+
+h9_idlisten <address> [<nonce>], from this game's own listen server
+==============
+*/
+static void CL_H9IdListen_f( void )
+{
+	char server[64], h9key[64], devmask[33], proof[65];
+	netadr_t adr;
+	int i, recent = 0;
+
+	if( Cmd_Argc() < 2 || Cmd_Argc() > 3 || cls.state < ca_connected || cls.demoplayback )
+		return;
+	if( NET_NetadrType( &cls.netchan.remote_address ) != NA_LOOPBACK )
+		return;
+	if( !H9_IsHex( cl_h9_userid.string, 32 ) || !H9L_Address( Cmd_Argv( 1 ), server, sizeof( server )))
+		return;
+	if( !NET_StringToAdr( server, &adr ) || NET_NetadrType( &adr ) != NA_IP )
+		return;
+
+	// the h9_clientid a player joining this server from elsewhere has, sent to the server when it changed
+	ID_GetMD5ForAddressEx( h9key, adr, sizeof( h9key ), cl_h9_userid.string );
+	if( Q_strcmp( Info_ValueForKey( cls.userinfo, "h9_clientid" ), h9key ))
+	{
+		Info_SetValueForKey( cls.userinfo, "h9_clientid", h9key, sizeof( cls.userinfo ));
+		CL_UpdateInfo( "h9_clientid", h9key );
+	}
+
+	if( Cmd_Argc() != 3 )
+		return;
+	if( !H9_IsHex( Cmd_Argv( 2 ), 32 ) || !H9L_Device( ))
+		return;
+
+	for( i = 0; i < 4; i++ )
+	{
+		if( h9l_answered[i] > 0.0 && host.realtime - h9l_answered[i] < 60.0 )
+			recent++;
+	}
+	if( recent >= 4 )
+		return;
+
+	H9_IdProof( cl_h9_userid.string, h9l_device, Cmd_Argv( 2 ), server, devmask, proof );
+	CL_ServerCommand( true, "h9_idproof %s %s %s", Cmd_Argv( 2 ), devmask, proof );
+	h9l_answered[h9l_next] = host.realtime;
+	h9l_next = ( h9l_next + 1 ) % 4;
+}
+
+/*
+==============
+CL_H9Listen_Init
+==============
+*/
+void CL_H9Listen_Init( void )
+{
+	Cvar_RegisterVariable( &cl_h9idl );
+	Cmd_AddCommand( "h9_idlisten", CL_H9IdListen_f, "H9: this game's own listen server's address, for its h9_clientid and ID proof (docs/H9_PRESENCE.txt)" );
+	Cvar_DirectSet( &cl_h9idl, "1" );
+}
+
+#else // XASH_EMSCRIPTEN
+
+void CL_H9Listen_Init( void )
+{
+}
+
+#endif // XASH_EMSCRIPTEN
diff --git a/engine/client/cl_idproof.c b/engine/client/cl_idproof.c
new file mode 100644
index 00000000..d88a23a2
--- /dev/null
+++ b/engine/client/cl_idproof.c
@@ -0,0 +1,374 @@
+/*
+cl_idproof.c - H9: the presence ID proof, the client's half (docs/H9_PRESENCE.txt, section 8)
+Copyright (C) 2026 HAVOC 9
+
+This program is free software: you can redistribute it and/or modify
+it under the terms of the GNU General Public License as published by
+the Free Software Foundation, either version 3 of the License, or
+(at your option) any later version.
+
+This program is distributed in the hope that it will be useful,
+but WITHOUT ANY WARRANTY; without even the implied warranty of
+MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
+GNU General Public License for more details.
+
+h9_clientid (identification.c, from cl_h9_userid) is the same value for a player on a server every
+time, and every player on that server receives it, so on its own it proves nothing. A server running
+h9_presence sends a joining client a one-time challenge, "h9_idchallenge <nonce>", and this file
+answers it with an HMAC keyed with the raw cl_h9_userid, which never leaves the game:
+
+  P        cl_h9_userid as its 32 ASCII characters, the HMAC key
+  S        the address the client is connected to, "a.b.c.d:port" (the one h9_clientid is salted with)
+  mask     the first 16 bytes of HMAC-SHA256(P, "h9dev1:" + nonce)
+  devmask  hex(device id XOR mask): the device id, which only h9web, knowing P, can unmask
+  proof    hex(HMAC-SHA256(P, "h9proof1:" + nonce + ":" + S + ":" + devmask))
+  answer   the client command "h9_idproof <nonce> <devmask> <proof>"
+
+The device id is 16 random bytes made by the OS on first use and kept in device_id.ini in the root
+folder ("[device]" then "id=<32 hex>"), apart from user_id.ini; nothing else reads it, and it is never
+sent in the clear. The userinfo key _h9idv is "1" while the device id is there, which is what makes a
+server challenge the client at all (a key starting with "_" is not sent to other players).
+
+h9_idchallenge is an ordinary command so that a server's stufftext runs it (cl_filterstuffcmd 1
+included: no filtered prefix). It answers only while connected, only a nonce of 32 lowercase hex
+characters, only with a cl_h9_userid of 32 lowercase hex characters, and at most four times a minute.
+
+SHA-256 is FIPS 180-4 and HMAC is RFC 2104: FWGS has MD5 and no SHA-256. A test build compiles the
+hashing part alone with H9_IDPROOF_SELFTEST defined.
+
+The browser build has neither the command nor the key: its players are vouched for by h9web's relay.
+*/
+
+#include <stdint.h>
+#include <stdio.h>
+#include <string.h>
+
+#ifndef H9_IDPROOF_SELFTEST
+#include "common.h"
+#include "client.h"
+#endif
+
+// ---- SHA-256 and HMAC-SHA256 ------------------------------------------------------------------
+
+typedef struct h9sha_s
+{
+	uint32_t h[8];
+	uint8_t  block[64];
+	size_t   blen;
+	uint64_t total;
+} h9sha_t;
+
+static const uint32_t h9sha_k[64] =
+{
+	0x428a2f98, 0x71374491, 0xb5c0fbcf, 0xe9b5dba5, 0x3956c25b, 0x59f111f1, 0x923f82a4, 0xab1c5ed5,
+	0xd807aa98, 0x12835b01, 0x243185be, 0x550c7dc3, 0x72be5d74, 0x80deb1fe, 0x9bdc06a7, 0xc19bf174,
+	0xe49b69c1, 0xefbe4786, 0x0fc19dc6, 0x240ca1cc, 0x2de92c6f, 0x4a7484aa, 0x5cb0a9dc, 0x76f988da,
+	0x983e5152, 0xa831c66d, 0xb00327c8, 0xbf597fc7, 0xc6e00bf3, 0xd5a79147, 0x06ca6351, 0x14292967,
+	0x27b70a85, 0x2e1b2138, 0x4d2c6dfc, 0x53380d13, 0x650a7354, 0x766a0abb, 0x81c2c92e, 0x92722c85,
+	0xa2bfe8a1, 0xa81a664b, 0xc24b8b70, 0xc76c51a3, 0xd192e819, 0xd6990624, 0xf40e3585, 0x106aa070,
+	0x19a4c116, 0x1e376c08, 0x2748774c, 0x34b0bcb5, 0x391c0cb3, 0x4ed8aa4a, 0x5b9cca4f, 0x682e6ff3,
+	0x748f82ee, 0x78a5636f, 0x84c87814, 0x8cc70208, 0x90befffa, 0xa4506ceb, 0xbef9a3f7, 0xc67178f2
+};
+
+#define H9_ROTR( x, n ) ((( x ) >> ( n )) | (( x ) << ( 32 - ( n ))))
+
+static void H9Sha_Block( h9sha_t *s )
+{
+	uint32_t w[64], a, b, c, d, e, f, g, h;
+	int i;
+
+	for( i = 0; i < 16; i++ )
+		w[i] = ((uint32_t)s->block[i * 4] << 24 ) | ((uint32_t)s->block[i * 4 + 1] << 16 ) | ((uint32_t)s->block[i * 4 + 2] << 8 ) | s->block[i * 4 + 3];
+	for( i = 16; i < 64; i++ )
+	{
+		uint32_t s0 = H9_ROTR( w[i - 15], 7 ) ^ H9_ROTR( w[i - 15], 18 ) ^ ( w[i - 15] >> 3 );
+		uint32_t s1 = H9_ROTR( w[i - 2], 17 ) ^ H9_ROTR( w[i - 2], 19 ) ^ ( w[i - 2] >> 10 );
+		w[i] = w[i - 16] + s0 + w[i - 7] + s1;
+	}
+
+	a = s->h[0]; b = s->h[1]; c = s->h[2]; d = s->h[3];
+	e = s->h[4]; f = s->h[5]; g = s->h[6]; h = s->h[7];
+	for( i = 0; i < 64; i++ )
+	{
+		uint32_t S1 = H9_ROTR( e, 6 ) ^ H9_ROTR( e, 11 ) ^ H9_ROTR( e, 25 );
+		uint32_t ch = ( e & f ) ^ ( ~e & g );
+		uint32_t t1 = h + S1 + ch + h9sha_k[i] + w[i];
+		uint32_t S0 = H9_ROTR( a, 2 ) ^ H9_ROTR( a, 13 ) ^ H9_ROTR( a, 22 );
+		uint32_t mj = ( a & b ) ^ ( a & c ) ^ ( b & c );
+		uint32_t t2 = S0 + mj;
+		h = g; g = f; f = e; e = d + t1;
+		d = c; c = b; b = a; a = t1 + t2;
+	}
+	s->h[0] += a; s->h[1] += b; s->h[2] += c; s->h[3] += d;
+	s->h[4] += e; s->h[5] += f; s->h[6] += g; s->h[7] += h;
+}
+
+static void H9Sha_Init( h9sha_t *s )
+{
+	static const uint32_t iv[8] = { 0x6a09e667, 0xbb67ae85, 0x3c6ef372, 0xa54ff53a, 0x510e527f, 0x9b05688c, 0x1f83d9ab, 0x5be0cd19 };
+
+	memcpy( s->h, iv, sizeof( iv ));
+	s->blen = 0;
+	s->total = 0;
+}
+
+static void H9Sha_Update( h9sha_t *s, const uint8_t *data, size_t len )
+{
+	while( len-- )
+	{
+		s->block[s->blen++] = *data++;
+		s->total++;
+		if( s->blen == 64 )
+		{
+			H9Sha_Block( s );
+			s->blen = 0;
+		}
+	}
+}
+
+static void H9Sha_Final( h9sha_t *s, uint8_t out[32] )
+{
+	uint64_t bits = s->total * 8;
+	uint8_t pad = 0x80;
+	int i;
+
+	H9Sha_Update( s, &pad, 1 );
+	pad = 0;
+	while( s->blen != 56 )
+		H9Sha_Update( s, &pad, 1 );
+	for( i = 7; i >= 0; i-- )
+	{
+		uint8_t b = (uint8_t)( bits >> ( i * 8 ));
+		H9Sha_Update( s, &b, 1 );
+	}
+	for( i = 0; i < 8; i++ )
+	{
+		out[i * 4] = (uint8_t)( s->h[i] >> 24 );
+		out[i * 4 + 1] = (uint8_t)( s->h[i] >> 16 );
+		out[i * 4 + 2] = (uint8_t)( s->h[i] >> 8 );
+		out[i * 4 + 3] = (uint8_t)s->h[i];
+	}
+}
+
+// HMAC-SHA256(key, msg) into out; keys longer than a block are hashed first (RFC 2104)
+static void H9_HmacSha256( const uint8_t *key, size_t keylen, const uint8_t *msg, size_t msglen, uint8_t out[32] )
+{
+	uint8_t k[64], pad[64], inner[32];
+	h9sha_t s;
+	int i;
+
+	memset( k, 0, sizeof( k ));
+	if( keylen > 64 )
+	{
+		H9Sha_Init( &s );
+		H9Sha_Update( &s, key, keylen );
+		H9Sha_Final( &s, k );
+	}
+	else memcpy( k, key, keylen );
+
+	for( i = 0; i < 64; i++ )
+		pad[i] = k[i] ^ 0x36;
+	H9Sha_Init( &s );
+	H9Sha_Update( &s, pad, 64 );
+	H9Sha_Update( &s, msg, msglen );
+	H9Sha_Final( &s, inner );
+
+	for( i = 0; i < 64; i++ )
+		pad[i] = k[i] ^ 0x5c;
+	H9Sha_Init( &s );
+	H9Sha_Update( &s, pad, 64 );
+	H9Sha_Update( &s, inner, 32 );
+	H9Sha_Final( &s, out );
+}
+
+static void H9_ToHex( const uint8_t *in, size_t n, char *out )
+{
+	static const char hex[] = "0123456789abcdef";
+	size_t i;
+
+	for( i = 0; i < n; i++ )
+	{
+		out[i * 2] = hex[in[i] >> 4];
+		out[i * 2 + 1] = hex[in[i] & 15];
+	}
+	out[n * 2] = 0;
+}
+
+// exactly n characters of 0-9 a-f
+static int H9_IsHex( const char *s, size_t n )
+{
+	size_t i;
+
+	for( i = 0; i < n; i++ )
+	{
+		if( !(( s[i] >= '0' && s[i] <= '9' ) || ( s[i] >= 'a' && s[i] <= 'f' )))
+			return 0;
+	}
+	return s[n] == 0;
+}
+
+static int H9_HexValue( char c )
+{
+	if( c >= '0' && c <= '9' ) return c - '0';
+	if( c >= 'a' && c <= 'f' ) return c - 'a' + 10;
+	if( c >= 'A' && c <= 'F' ) return c - 'A' + 10;
+	return -1;
+}
+
+// The answer to one challenge: devmask (33 bytes) and proof (65 bytes), as h9web checks them.
+static void H9_IdProof( const char *userid, const uint8_t device[16], const char *nonce, const char *server, char devmask[33], char proof[65] )
+{
+	uint8_t mac[32], dm[16];
+	char text[256];
+	size_t n;
+	int i;
+
+	n = (size_t)snprintf( text, sizeof( text ), "h9dev1:%s", nonce );
+	H9_HmacSha256( (const uint8_t *)userid, strlen( userid ), (const uint8_t *)text, n, mac );
+	for( i = 0; i < 16; i++ )
+		dm[i] = device[i] ^ mac[i];
+	H9_ToHex( dm, 16, devmask );
+
+	n = (size_t)snprintf( text, sizeof( text ), "h9proof1:%s:%s:%s", nonce, server, devmask );
+	H9_HmacSha256( (const uint8_t *)userid, strlen( userid ), (const uint8_t *)text, n, mac );
+	H9_ToHex( mac, 32, proof );
+}
+
+#ifndef H9_IDPROOF_SELFTEST
+#if !XASH_EMSCRIPTEN
+
+#if XASH_WIN32
+#include <windows.h>
+// RtlGenRandom, as ntsecapi.h declares it (advapi32, which the engine links)
+BOOLEAN NTAPI SystemFunction036( PVOID RandomBuffer, ULONG RandomBufferLength );
+#endif
+
+static CVAR_DEFINE( cl_h9idv, "_h9idv", "0", FCVAR_USERINFO|FCVAR_PRIVILEGED, "H9: 1 while this game can answer the presence ID proof (set by the engine, cl_idproof.c)" );
+
+static uint8_t h9_device[16];
+static qboolean h9_device_ok;
+static double h9_answered[4]; // when the last four answers went, a ring
+static int h9_next;
+
+static qboolean H9_RandomBytes( uint8_t *out, size_t n )
+{
+#if XASH_WIN32
+	return SystemFunction036( out, (ULONG)n ) ? true : false;
+#else
+	FILE *f = fopen( "/dev/urandom", "rb" );
+	size_t got;
+
+	if( !f )
+		return false;
+	got = fread( out, 1, n, f );
+	fclose( f );
+	return got == n;
+#endif
+}
+
+// device_id.ini in the root folder: read it, or make it when there is none. A file that is there but
+// cannot be read as one is left alone, and the game answers no challenge.
+static qboolean H9_DeviceLoad( void )
+{
+	char root[MAX_SYSPATH], path[MAX_SYSPATH], text[512], hex[33];
+	const char *id;
+	FILE *f;
+	size_t n;
+	int i;
+
+	if( !g_fsapi.GetRootDirectory( root, sizeof( root )))
+		return false;
+	Q_snprintf( path, sizeof( path ), "%s/device_id.ini", root );
+
+	f = fopen( path, "rb" );
+	if( f )
+	{
+		n = fread( text, 1, sizeof( text ) - 1, f );
+		fclose( f );
+		text[n] = 0;
+		id = Q_strstr( text, "id=" );
+		if( !id )
+		{
+			Con_Printf( S_WARN "%s has no id= line: the presence ID proof is off\n", path );
+			return false;
+		}
+		id += 3;
+		for( i = 0; i < 16; i++ )
+		{
+			int hi = H9_HexValue( id[i * 2] ), lo = H9_HexValue( id[i * 2 + 1] );
+
+			if( hi < 0 || lo < 0 )
+			{
+				Con_Printf( S_WARN "%s holds no device id of 32 hex characters: the presence ID proof is off\n", path );
+				return false;
+			}
+			h9_device[i] = (uint8_t)( hi * 16 + lo );
+		}
+		return true;
+	}
+
+	if( !H9_RandomBytes( h9_device, sizeof( h9_device )))
+		return false;
+	f = fopen( path, "wb" );
+	if( !f )
+		return false;
+	H9_ToHex( h9_device, sizeof( h9_device ), hex );
+	fprintf( f, "[device]\nid=%s\n", hex );
+	fclose( f );
+	return true;
+}
+
+/*
+==============
+CL_H9IdChallenge_f
+
+h9_idchallenge <nonce>, from the server
+==============
+*/
+static void CL_H9IdChallenge_f( void )
+{
+	const char *nonce = Cmd_Argv( 1 );
+	char server[64], devmask[33], proof[65];
+	int i, recent = 0;
+
+	if( Cmd_Argc() != 2 || cls.state < ca_connected || !h9_device_ok )
+		return;
+	if( !H9_IsHex( nonce, 32 ) || !H9_IsHex( cl_h9_userid.string, 32 ))
+		return;
+
+	for( i = 0; i < 4; i++ )
+	{
+		if( h9_answered[i] > 0.0 && host.realtime - h9_answered[i] < 60.0 )
+			recent++;
+	}
+	if( recent >= 4 )
+		return;
+
+	Q_strncpy( server, NET_AdrToString( cls.netchan.remote_address ), sizeof( server ));
+	H9_IdProof( cl_h9_userid.string, h9_device, nonce, server, devmask, proof );
+	CL_ServerCommand( true, "h9_idproof %s %s %s", nonce, devmask, proof );
+	h9_answered[h9_next] = host.realtime;
+	h9_next = ( h9_next + 1 ) % 4;
+}
+
+/*
+==============
+CL_H9Id_Init
+==============
+*/
+void CL_H9Id_Init( void )
+{
+	Cvar_RegisterVariable( &cl_h9idv );
+	Cmd_AddCommand( "h9_idchallenge", CL_H9IdChallenge_f, "H9: answers the server's presence ID challenge (docs/H9_PRESENCE.txt)" );
+	h9_device_ok = H9_DeviceLoad();
+	Cvar_DirectSet( &cl_h9idv, h9_device_ok ? "1" : "0" );
+}
+
+#else // XASH_EMSCRIPTEN
+
+void CL_H9Id_Init( void )
+{
+}
+
+#endif // XASH_EMSCRIPTEN
+#endif // H9_IDPROOF_SELFTEST
