+const char *EMSCRIPTEN_GetFuncName(void *hInstance, void *address)
+{
+    return EM_ASM_PTR({
+        const hInstance = $0;
+        const address = $1;
+        const funcJsRef = getWasmTableEntry(address).name;
+        const exports = Object.entries(LDSO.loadedLibsByHandle[hInstance]?.exports ?? {});
