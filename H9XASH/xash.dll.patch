 	do
 	{
 		clgame.dllFuncs.pfnCalcRefdef( &rp );
+		V_RestoreServerCloak();
 
 		// client dll may replace viewmodel in pfnCalcRefdef, so set animtime again
 		// V_SetupViewModel did it only for the model known before this call
