+static void Delta_H9WidenIndexField( const delta_info_t *dt, delta_t *pField )
+{
+	// magnitude bits; a DT_SIGNED field gets one more for its sign
+	static struct
+	{
+		const char	*table;
+		const char	*field;
+		int		bits;
+		qboolean	reported;
+	} widen[] =
+	{
+	{ "clientdata_t",		"viewmodel",	MAX_MODEL_BITS },
+	{ "entity_state_t",		"modelindex",	MAX_MODEL_BITS },
+	{ "entity_state_t",		"weaponmodel",	MAX_MODEL_BITS },
+	{ "entity_state_t",		"aiment",	MAX_ENTITY_BITS },
+	{ "entity_state_t",		"owner",	MAX_CLIENT_BITS + 1 },	// a player index, 1..MAX_CLIENTS
+	{ "entity_state_t",		"skin",		MAX_ENTITY_BITS },	// an attached sprite's target entity
+	{ "entity_state_player_t",	"modelindex",	MAX_MODEL_BITS },
+	{ "entity_state_player_t",	"weaponmodel",	MAX_MODEL_BITS },
+	{ "entity_state_player_t",	"aiment",	MAX_ENTITY_BITS },
+	{ "entity_state_player_t",	"owner",	MAX_CLIENT_BITS + 1 },
+	{ "event_t",			"entindex",	MAX_ENTITY_BITS },
+	};
+
+	for( size_t i = 0; i < ARRAYSIZE( widen ); i++ )
+	{
+		if( Q_strcmp( dt->pName, widen[i].table ) || Q_strcmp( pField->name, widen[i].field ))
+			continue;
+
+		int limit = FBitSet( pField->flags, DT_BYTE ) ? 8 : FBitSet( pField->flags, DT_SHORT ) ? 16 : 32;
+		int want = Q_min( widen[i].bits + ( FBitSet( pField->flags, DT_SIGNED ) ? 1 : 0 ), limit );
+
+		if( pField->bits < want )
+		{
+			// delta.lst is re-read on every map spawn; one line per field per run is enough
+			if( !widen[i].reported )
+			{
+				Con_Printf( "delta: %s.%s widened from %d to %d bits\n", dt->pName, pField->name, pField->bits, want );
+				widen[i].reported = true;
+			}
+			pField->bits = want;
+		}
+		return;
+	}
+}
