+/*
+===============
+R_EndFrame
+===============
+*/
+void R_EndFrame( void )
+{
+	GL_PresentScreenTarget();
+#if XASH_PSVITA
+	VGL_ShimEndFrame();
+#endif
+#if !defined( XASH_GL_STATIC )
+	GL2_ShimEndFrame();
+#endif
+
+	// flush any remaining 2D bits
+	R_Set2DMode( false );
+	gEngfuncs.GL_SwapBuffers();
+}
