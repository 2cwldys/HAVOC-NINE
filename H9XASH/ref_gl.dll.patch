+=============
+static void R_DrawEntitiesOnList( void )
+	GL_CheckForErrors();
+	// first draw solid entities
+	for( int i = 0; i < tr.draw_list->num_solid_entities && !FBitSet( RI.rvp.flags, RF_ONLY_CLIENTDRAW ); i++ )
+		RI.currententity = tr.draw_list->solid_entities[i];
