+		// its own light: the room's does not dim it
+		int v = (int)( 255.0f * R_StudioFlow( ptricmds ));
+		color[0] = color[1] = color[2] = v;
+		return;
+	}
 	R_LightLambert( g_studio.lightpos[ptricmds[0]], pstudionorms[ptricmds[1]], lv, color );
 }
 
