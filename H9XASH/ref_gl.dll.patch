+		ClearBits( gl_overbright.flags, FCVAR_CHANGED );
+		rebuild = true;
+	if( FBitSet( r_vbo.flags, FCVAR_CHANGED ))
+		ClearBits( r_vbo.flags, FCVAR_CHANGED );
+		R_EnableVBO( r_vbo.value ? true : false );
+		if( R_HasEnabledVBO( ))
