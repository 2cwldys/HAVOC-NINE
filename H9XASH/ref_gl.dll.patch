+static int R_RankForRenderMode( int rendermode )
+	switch( rendermode )
+	case kRenderTransTexture:
+		return 1;	// draw second
+	case kRenderTransAdd:
+		return 2;	// draw third
+	case kRenderGlow:
+		return 3;	// must be last!
