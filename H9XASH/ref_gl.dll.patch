+		switch( RI.currentmodel->type )
+		case mod_brush:
+			R_DrawBrushModel( RI.currententity );
+			break;
+		case mod_alias:
+			R_DrawAliasModel( RI.currententity );
+			break;
+		case mod_studio:
+			R_DrawStudioModel( RI.currententity );
+			break;
+		default:
+			break;
+	GL_CheckForErrors();
+	// quake-specific feature
+	R_DrawAlphaTextureChains();
