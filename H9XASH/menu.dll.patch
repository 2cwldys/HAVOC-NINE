+static bool UI_HasStartupTrack( void )
+{
+	static const char *exts[] = { "mp3", "wav", "ogg", "opus" };
+	char path[64];
+
+	for( int i = 0; i < ARRAYSIZE( exts ); i++ )
+	{
+		snprintf( path, sizeof( path ), "media/gamestartup.%s", exts[i] );
+		if( EngFuncs::FileExists( path ))
+			return true;
+	}
+
+	return false;
+}
