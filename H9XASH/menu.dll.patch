H9XASH menu.dll -- built from patched source by TSM\xash3d-h9-patches\xash.bat

The main menu, mainui. engine-mainui.patch (webassembly) and mainui-h9-gamestartup.patch (a track a config started keeps playing).

Upstream: FWGS master e8d773ea. Built: branch h9 at 930926d2. Below is the whole
source change, paths from the xash3d-fwgs root; "git apply" replays it on a clone.

diff --git a/3rdparty/mainui/BaseMenu.cpp b/3rdparty/mainui/BaseMenu.cpp
index 7b727eb..2dd83a7 100755
--- a/3rdparty/mainui/BaseMenu.cpp
+++ b/3rdparty/mainui/BaseMenu.cpp
@@ -624,6 +624,29 @@ static bool UI_UpdateWindowInsets( void )
 	return changed;
 }
 
+/*
+=================
+UI_HasStartupTrack
+
+H9: the engine stops the playing track before it opens a new one, so asking
+for a start-up track the game does not have silences one its config started.
+=================
+*/
+static bool UI_HasStartupTrack( void )
+{
+	static const char *exts[] = { "mp3", "wav", "ogg", "opus" };
+	char path[64];
+
+	for( int i = 0; i < ARRAYSIZE( exts ); i++ )
+	{
+		snprintf( path, sizeof( path ), "media/gamestartup.%s", exts[i] );
+		if( EngFuncs::FileExists( path ))
+			return true;
+	}
+
+	return false;
+}
+
 /*
 =================
 UI_UpdateMenu
@@ -693,7 +716,7 @@ void UI_UpdateMenu( float flTime )
 				return;
 
 			// load background track
-			if( !CL_IsActive( ))
+			if( !CL_IsActive( ) && UI_HasStartupTrack( ))
 				EngFuncs::PlayBackgroundTrack( "media/gamestartup", "media/gamestartup" );
 		}
 
