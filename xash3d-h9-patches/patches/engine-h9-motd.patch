+qboolean CL_Motd_Active( void )
+{
+	return motd.state == H9M_OPEN && cls.state == ca_active && cls.key_dest == key_game;
+}
+
+int CL_Motd_MouseFrame( qboolean mouse_active )
+{
+	if( CL_Motd_Active( ))
+	{
+		if( !mouse_active )
+			return 0;
+
+		motd.took_mouse = true;
+		return 1;
+	}
+
+	if( !motd.took_mouse )
+		return 0;
+
+	// given back once; out of the game (console, menu) the key_dest change gives it back
+	motd.took_mouse = false;
+	return ( !mouse_active && cls.key_dest == key_game ) ? 2 : 0;
+}
+
+#if !XASH_EMSCRIPTEN
+static const rgba_t h9m_white = { 255, 250, 255, 255 };
+static const rgba_t h9m_light = { 223, 213, 245, 255 };
+static const rgba_t h9m_soft  = { 178, 146, 226, 255 };
+
+static void H9M_Fill( int x, int y, int w, int h, byte r, byte g, byte b, byte a )
+{
+	ref.dllFuncs.FillRGBA( kRenderTransTexture, x, y, w, h, r, g, b, a );
+}
+
+static void H9M_Border( int x, int y, int w, int h, int t )
+{
+	H9M_Fill( x, y, w, t, 138, 66, 196, 255 );
+	H9M_Fill( x, y + h - t, w, t, 138, 66, 196, 255 );
+	H9M_Fill( x, y, t, h, 138, 66, 196, 255 );
+	H9M_Fill( x + w - t, y, t, h, 138, 66, 196, 255 );
+}
+
+static int H9M_Width( cl_font_t *font, const char *s, int n )
+{
+	int w = 0;
+
+	for( int i = 0; i < n && s[i]; i++ )
+		w += font->charWidths[(byte)s[i]];
+
+	return w;
+}
+
+static void H9M_Text( cl_font_t *font, int x, int y, const char *s, int n, const rgba_t color )
+{
+	for( int i = 0; i < n && s[i]; i++ )
+		x += CL_DrawCharacter( x, y, (byte)s[i], color, font, 0 );
+}
+
+// how many characters of s fit in maxw (one at least), broken after a space when words is set
+static int H9M_Fit( cl_font_t *font, const char *s, int maxw, qboolean words )
+{
+	int w = 0, i, space = -1;
+
+	for( i = 0; s[i] && s[i] != '\n'; i++ )
+	{
+		int cw = font->charWidths[(byte)s[i]];
+
+		if( w + cw > maxw && i > 0 )
+			return ( words && space > 0 ) ? space + 1 : i;
+
+		if( s[i] == ' ' )
+			space = i;
+
+		w += cw;
+	}
+
+	return i;
+}
+
+// s wrapped to maxw; draws count lines from line first at x, y, and returns how many lines it makes
+static int H9M_Lines( cl_font_t *font, const char *s, int maxw, qboolean words, int first, int count, int x, int y, const rgba_t color )
+{
+	int line = 0;
+
+	while( *s )
+	{
+		int n = H9M_Fit( font, s, maxw, words );
+
+		if( line >= first && line < first + count )
+			H9M_Text( font, x, y + ( line - first ) * font->charHeight, s, n, color );
+
+		line++;
+		s += n;
+
+		if( *s == '\n' )
+			s++;
+	}
+
+	return line;
+}
+
+// one line, cut short with ... when it does not fit
+static void H9M_Line( cl_font_t *font, int x, int y, int maxw, const char *s, const rgba_t color )
+{
+	int len = Q_strlen( s ), n;
+
+	if( H9M_Width( font, s, len ) <= maxw )
+	{
+		H9M_Text( font, x, y, s, len, color );
+		return;
+	}
+
+	n = H9M_Fit( font, s, Q_max( 0, maxw - H9M_Width( font, "...", 3 )), false );
+	H9M_Text( font, x, y, s, n, color );
+	H9M_Text( font, x + H9M_Width( font, s, n ), y, "...", 3, color );
+}
+
+static void H9M_SetRect( int id, int x, int y, int w, int h )
+{
+	motd.btn[id].x = x;
+	motd.btn[id].y = y;
+	motd.btn[id].w = w;
+	motd.btn[id].h = h;
+	motd.btn[id].shown = true;
+}
+
+static qboolean H9M_Hit( int id, int x, int y )
+{
+	const h9m_rect_t *r = &motd.btn[id];
+
+	return r->shown && x >= r->x && x < r->x + r->w && y >= r->y && y < r->y + r->h;
+}
+
+static void H9M_Button( cl_font_t *font, int id, int x, int y, int w, int h, const char *label, int mx, int my )
+{
+	qboolean hot;
+	int tw = Q_min( w, H9M_Width( font, label, Q_strlen( label )));
+
+	H9M_SetRect( id, x, y, w, h );
+	hot = H9M_Hit( id, mx, my );
+
+	H9M_Fill( x, y, w, h, hot ? 138 : 40, hot ? 66 : 24, hot ? 196 : 58, 255 );
+	H9M_Border( x, y, w, h, 1 );
+	H9M_Line( font, x + ( w - tw ) / 2, y + ( h - font->charHeight ) / 2, w, label, h9m_white );
+}
+
+// the mouse pointer: the game hides the system's while it plays
+static void H9M_Cursor( int x, int y, int u )
+{
+	for( int r = 0; r < 13; r++ )
+		H9M_Fill( x, y + r * u, ( r < 11 ? r + 1 : 11 ) * u, u, 0, 0, 0, 255 );
+
+	for( int r = 2; r < 11; r++ )
+		H9M_Fill( x + u, y + r * u, ( r - 1 ) * u, u, 255, 250, 255, 255 );
+}
+
+static void H9M_Scroll( int delta )
+{
+	int most = Q_max( 0, motd.lines - motd.visible );
+
+	motd.scroll = bound( 0, motd.scroll + delta, most );
+}
+
+// a page with no picture shows TS's text in its place
+static const char *H9M_Body( void )
+{
+	if( motd.text[0] )
+		return motd.text;
+
+	return "This server's message of the day is a web page. OPEN PAGE opens it in your web browser.";
+}
+
+// the address OPEN PAGE goes to, whole, with the site on its own line, before a second click
+static void H9M_DrawConfirm( cl_font_t *font, int W, int H, int pad, int bh, int mx, int my )
+{
+	static const char ask[] = "Open this address in your web browser?";
+	char site[H9M_MAX_HOST + 8];
+	int lh = font->charHeight;
+	int dw = Q_min( W - pad * 4, H9M_Width( font, "n", 1 ) * 64 + pad * 2 );
+	int tw = dw - pad * 2;
+	int asklines = H9M_Lines( font, ask, tw, true, 0, 0, 0, 0, h9m_white );
+	int urllines = H9M_Lines( font, motd.page, tw, false, 0, 0, 0, 0, h9m_white );
+	int dh = pad + lh * ( asklines + 1 ) + pad / 2 + lh * urllines + pad + bh + pad;
+	int dx = ( W - dw ) / 2, dy = ( H - dh ) / 2, y, cw, gw;
+
+	H9M_Fill( 0, 0, W, H, 0, 0, 0, 120 );
+	H9M_Fill( dx, dy, dw, dh, 20, 10, 30, 250 );
+	H9M_Border( dx, dy, dw, dh, 2 );
+	H9M_SetRect( H9M_BTN_DIALOG, dx, dy, dw, dh );
+
+	y = dy + pad;
+	H9M_Lines( font, ask, tw, true, 0, asklines, dx + pad, y, h9m_light );
+	y += lh * asklines;
+
+	Q_snprintf( site, sizeof( site ), "Site: %s", motd.page_host );
+	H9M_Line( font, dx + pad, y, tw, site, h9m_white );
+	y += lh + pad / 2;
+
+	H9M_Lines( font, motd.page, tw, false, 0, urllines, dx + pad, y, h9m_soft );
+	y += lh * urllines + pad;
+
+	cw = H9M_Width( font, "CANCEL", 6 ) + pad * 2;
+	gw = H9M_Width( font, "OPEN IN BROWSER", 15 ) + pad * 2;
+	H9M_Button( font, H9M_BTN_CANCEL, dx + dw - pad - cw, y, cw, bh, "CANCEL", mx, my );
+	H9M_Button( font, H9M_BTN_GO, dx + dw - pad - cw - pad - gw, y, gw, bh, "OPEN IN BROWSER", mx, my );
+}
+#endif // !XASH_EMSCRIPTEN
