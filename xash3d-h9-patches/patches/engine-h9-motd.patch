+void CL_Motd_Draw( void )
+{
+#if !XASH_EMSCRIPTEN
+	char label[H9M_MAX_HOST + 32];
+	cl_font_t *font;
+	int W, H, lh, pad, bh, margin, head, foot, maxw, maxh, minw;
+	int pw, ph, px, py, bodyw, bodyh, mx, my, bmx, bmy;
+
+	if( motd.state != H9M_OPEN || cls.state != ca_active )
+		return;
+
+	font = Con_GetCurFont();
+
+	if( !font || !font->valid || font->charHeight <= 0 )
+		return;
+
+	W = refState.width;
+	H = refState.height;
+	lh = font->charHeight;
+	pad = Q_max( 6, lh / 2 );
+	bh = lh + pad;
+	margin = Q_max( 8, Q_min( W, H ) / 30 );
+	head = pad + lh * 2 + pad;
+	foot = pad + bh + pad;
+	maxw = W - margin * 2;
+	maxh = H - margin * 2;
+	minw = Q_min( maxw, H9M_Width( font, "M", 1 ) * 36 + pad * 2 );
+
+	if( maxw <= pad * 4 || maxh <= head + foot + lh )
+		return;
+
+	memset( motd.btn, 0, sizeof( motd.btn ));
+	Platform_GetMousePos( &mx, &my );
+
+	// the panel's buttons do not light up under the address box
+	bmx = motd.confirm ? -1 : mx;
+	bmy = motd.confirm ? -1 : my;
+
+	if( motd.texture )
+	{
+		// the picture fits the screen; a small one grows up to the screen's own scale
+		float s = Q_min(( maxw - pad * 2 ) / (float)motd.picw, ( maxh - head - foot ) / (float)motd.pich );
+
+		s = Q_min( s, Q_max( 1.0f, H / 768.0f ));
+		bodyw = Q_max( 1, (int)( motd.picw * s ));
+		bodyh = Q_max( 1, (int)( motd.pich * s ));
+		pw = Q_max( bodyw + pad * 2, minw );
+	}
+	else
+	{
+		pw = Q_max( minw, Q_min( maxw, H9M_Width( font, "n", 1 ) * 72 + pad * 2 ));
+		bodyw = pw - pad * 2;
+		motd.lines = H9M_Lines( font, H9M_Body(), bodyw - pad, true, 0, 0, 0, 0, h9m_white );
+		motd.visible = Q_max( 1, ( maxh - head - foot ) / lh );
+		motd.visible = Q_min( motd.visible, Q_max( motd.lines, 4 ));
+		bodyh = motd.visible * lh;
+		H9M_Scroll( 0 );
+	}
+
+	ph = head + bodyh + foot;
+	px = ( W - pw ) / 2;
+	py = ( H - ph ) / 2;
+
+	H9M_Fill( 0, 0, W, H, 0, 0, 0, 150 );
+	H9M_Fill( px, py, pw, ph, 14, 8, 20, 240 );
+	H9M_Border( px, py, pw, ph, Q_max( 1, lh / 12 ));
+
+	// the title, then where it comes from: the host is always on screen
+	H9M_Line( font, px + pad, py + pad, pw - pad * 2, motd.title[0] ? motd.title : "Message of the day", h9m_light );
+
+	if( motd.is_page )
+		Q_snprintf( label, sizeof( label ), "Web page at %s", motd.page_host );
+	else Q_snprintf( label, sizeof( label ), "Picture from %s", motd.image_host );
+
+	H9M_Line( font, px + pad, py + pad + lh, pw - pad * 2, label, h9m_soft );
+
+	if( motd.texture )
+	{
+		ref.dllFuncs.GL_SetRenderMode( kRenderTransTexture );
+		ref.dllFuncs.Color4ub( 255, 255, 255, 255 );
+		ref.dllFuncs.R_DrawStretchPic( px + ( pw - bodyw ) / 2, py + head, bodyw, bodyh, 0, 0, 1, 1, motd.texture );
+	}
+	else
+	{
+		H9M_Lines( font, H9M_Body(), bodyw - pad, true, motd.scroll, motd.visible, px + pad, py + head, h9m_white );
+
+		if( motd.lines > motd.visible )
+		{
+			int thumb = Q_max( lh / 2, bodyh * motd.visible / motd.lines );
+			int at = ( bodyh - thumb ) * motd.scroll / Q_max( 1, motd.lines - motd.visible );
+
+			H9M_Fill( px + pw - pad - 3, py + head + at, 3, thumb, 138, 66, 196, 255 );
+		}
+	}
+
+	// CLOSE at the right, OPEN PAGE beside it when there is a page
+	{
+		int y = py + ph - pad - bh;
+		int cw = H9M_Width( font, "CLOSE (ESC)", 11 ) + pad * 2;
+		int x = px + pw - pad - cw;
+
+		H9M_Button( font, H9M_BTN_CLOSE, x, y, cw, bh, "CLOSE (ESC)", bmx, bmy );
+
+		if( motd.page[0] )
+		{
+			int ow;
+
+			Q_snprintf( label, sizeof( label ), "OPEN PAGE (%s)", motd.page_host );
+			ow = Q_min( H9M_Width( font, label, Q_strlen( label )) + pad * 2, x - px - pad * 2 );
+
+			if( ow > pad * 4 )
+				H9M_Button( font, H9M_BTN_OPEN, x - pad - ow, y, ow, bh, label, bmx, bmy );
+		}
+	}
+
+	if( motd.confirm )
+		H9M_DrawConfirm( font, W, H, pad, bh, mx, my );
+
+	if( !host.mouse_visible )
+		H9M_Cursor( mx, my, Q_max( 1, H / 540 ));
+
+	ref.dllFuncs.Color4ub( 255, 255, 255, 255 );
+	ref.dllFuncs.GL_SetRenderMode( kRenderNormal );
+#endif // !XASH_EMSCRIPTEN
+}
+
+qboolean CL_Motd_KeyEvent( int key, qboolean down )
+{
+	if( key < 0 || key >= (int)ARRAYSIZE( motd.eat ))
+		return false;
+
+	if( !down )
+	{
+		// the release of a key the splash took is the splash's too
+		if( !motd.eat[key] )
+			return false;
+
+		motd.eat[key] = false;
+		return true;
+	}
+
+	// the console stays within reach
+	if( !CL_Motd_Active( ) || key == '`' || key == '~' )
+		return false;
+
+#if !XASH_EMSCRIPTEN
+	motd.eat[key] = true;
+
+	switch( key )
+	{
+	case K_ESCAPE:
+	case K_ENTER:
+	case K_KP_ENTER:
+	case K_SPACE:
+		// a key closes the address box or the splash; it never opens the browser
+		if( motd.confirm )
+			motd.confirm = false;
+		else H9M_Stop();
+		break;
+	case K_UPARROW:
+	case K_MWHEELUP:
+		H9M_Scroll( -1 );
+		break;
+	case K_DOWNARROW:
+	case K_MWHEELDOWN:
+		H9M_Scroll( 1 );
+		break;
+	case K_PGUP:
+		H9M_Scroll( -Q_max( 1, motd.visible - 1 ));
+		break;
+	case K_PGDN:
+		H9M_Scroll( Q_max( 1, motd.visible - 1 ));
+		break;
+	case K_HOME:
+		motd.scroll = 0;
+		break;
+	case K_END:
+		H9M_Scroll( motd.lines );
+		break;
+	default:
+		break;
+	}
+
+	return true;
+#else
+	return false;
+#endif
+}
+
+qboolean CL_Motd_MouseEvent( int button, qboolean down )
+{
+	int key = K_MOUSE1 + button;
+
+	if( key < K_MOUSE1 || key > K_MOUSE5 )
+		return false;
+
+	if( !down )
+	{
+		if( !motd.eat[key] )
+			return false;
+
+		motd.eat[key] = false;
+		return true;
+	}
+
+	if( !CL_Motd_Active( ))
+		return false;
+
+#if !XASH_EMSCRIPTEN
+	motd.eat[key] = true;
+
+	if( key == K_MOUSE1 )
+	{
+		int mx, my;
+
+		Platform_GetMousePos( &mx, &my );
+
+		if( motd.confirm )
+		{
+			// the only way to the browser: a click on OPEN IN BROWSER, with the address on screen
+			if( H9M_Hit( H9M_BTN_GO, mx, my ))
+			{
+				Con_Printf( "H9 MOTD: opening %s in the web browser\n", motd.page );
+				Platform_ShellExecute( motd.page, NULL );
+				motd.confirm = false;
+			}
+			else if( H9M_Hit( H9M_BTN_CANCEL, mx, my ) || !H9M_Hit( H9M_BTN_DIALOG, mx, my ))
+				motd.confirm = false;
+		}
+		else if( H9M_Hit( H9M_BTN_CLOSE, mx, my ))
+			H9M_Stop();
+		else if( motd.page[0] && H9M_Hit( H9M_BTN_OPEN, mx, my ))
+			motd.confirm = true;
+	}
+
+	return true;
+#else
+	return false;
+#endif
+}
+
+void CL_Motd_Reset( qboolean connection )
+{
+	H9M_Stop();
+	motd.textfate = H9M_TEXT_PASS;
+	motd.heldlen = 0;
+	motd.text[0] = '\0';
+	motd.text_done = false;
+	motd.infolen = 0;
+	motd.info[0] = '\0';
+	motd.infobad = false;
+	memset( motd.eat, 0, sizeof( motd.eat ));
+
+	if( connection )
+		motd.shown = false;
+}
+
+void CL_Motd_Init( void )
+{
+	Cvar_RegisterVariable( &cl_h9_motd );
+#if XASH_EMSCRIPTEN
+	Cmd_AddRestrictedCommand( "h9_motd_result", H9M_Result_f, "H9: the web client's answer to a splash MOTD (1 shown, 0 not shown)" );
+#endif
+}
