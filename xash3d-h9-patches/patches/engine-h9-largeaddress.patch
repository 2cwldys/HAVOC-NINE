diff --git a/game_launch/wscript b/game_launch/wscript
index 2e2fff68..137fed4d 100644
--- a/game_launch/wscript
+++ b/game_launch/wscript
@@ -30,10 +30,18 @@ def build(bld):
 	if bld.env.DEST_OS == 'linux':
 		bld.env.LDFLAGS += ['-Wl,--no-as-needed', '-lm']
 
+	# H9: the 32-bit Windows launcher is large-address-aware, so on 64-bit Windows the game and a
+	# dedicated server get 4 GB of address space instead of 2. Only the executable's flag counts;
+	# the DLLs the process loads need nothing.
+	linkflags = []
+	if bld.env.DEST_OS == 'win32' and bld.env.DEST_CPU == 'x86' and bld.env.COMPILER_CC == 'msvc':
+		linkflags += ['/LARGEADDRESSAWARE']
+
 	bld.program(source = source,
 		target   = 'xash3d', # hl.exe
 		use      = 'sdk_includes DL USER32 SHELL32 werror yy_thunks',
 		rpath    = bld.env.DEFAULT_RPATH,
 		install_path = bld.env.BINDIR,
+		linkflags = linkflags,
 		subsystem = bld.env.MSVC_SUBSYSTEM
 	)
