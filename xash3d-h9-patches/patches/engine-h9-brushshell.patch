+/*
+=================
+R_DrawBrushShell
+
+H9: kRenderFxGlowShell on a brush entity. GoldSrc and Xash draw the glow shell on studio
+models only; a brush sent with it (ts_matchmode's siege objectives, coloured per viewer) gets
+one more pass after its own here: each of its faces again, pushed out along the face's plane
+by H9_BRUSH_SHELL_PUSH plus renderamt / 128 units, through the chrome sprite (white when
+sprites/shellchrome.spr is not loaded, as engine-h9-shellwhite.patch does for a model), in the
+entity's rendercolor, additive, and scrolling as the chrome does.
+=================
+*/
+#define H9_BRUSH_SHELL_PUSH 1.0f
+
+static void R_DrawBrushShell( cl_entity_t *e, model_t *clmodel )
+{
+	msurface_t *psurf = &clmodel->surfaces[clmodel->firstmodelsurface];
+	model_t *chrome = gEngfuncs.GetDefaultSprite( REF_CHROME_SPRITE );
+	float push = H9_BRUSH_SHELL_PUSH + e->curstate.renderamt * ( 1.0f / 128.0f );
+	float scroll = gp_cl->time * 0.25f;
+
+	GL_CleanUpTextureUnits( 0 );
+	if( !TriSpriteTexture( chrome, 0 ))
+		GL_Bind( XASH_TEXTURE0, tr.whiteTexture );
+
+	R_AllowFog( false );
+	pglEnable( GL_BLEND );
+	pglBlendFunc( GL_SRC_ALPHA, GL_ONE );
+	pglDepthMask( GL_FALSE );
+	pglTexEnvf( GL_TEXTURE_ENV, GL_TEXTURE_ENV_MODE, GL_MODULATE );
+	pglColor4ub( e->curstate.rendercolor.r, e->curstate.rendercolor.g, e->curstate.rendercolor.b, 255 );
+
+	for( int i = 0; i < clmodel->nummodelsurfaces; i++, psurf++ )
+	{
+		vec3_t normal;
+
+		if( FBitSet( psurf->flags, SURF_DRAWSKY ) || !psurf->polys || !psurf->plane )
+			continue;
+
+		VectorCopy( psurf->plane->normal, normal );
+		if( FBitSet( psurf->flags, SURF_PLANEBACK ))
+			VectorNegate( normal, normal );
+
+		for( glpoly2_t *p = psurf->polys; p; p = p->next )
+		{
+			pglBegin( GL_POLYGON );
+			for( int j = 0; j < p->numverts; j++ )
+			{
+				const float *v = p->verts[j];
+				vec3_t pos;
+
+				VectorMA( v, push, normal, pos );
+				pglTexCoord2f(( v[0] + v[1] ) * ( 1.0f / 64.0f ) + scroll, v[2] * ( 1.0f / 64.0f ) + scroll );
+				pglVertex3fv( pos );
+			}
+			pglEnd();
+		}
+	}
+
+	pglColor4ub( 255, 255, 255, 255 );
+	pglTexEnvf( GL_TEXTURE_ENV, GL_TEXTURE_ENV_MODE, GL_REPLACE );
+	pglDepthMask( GL_TRUE );
+	pglDisable( GL_BLEND );
+	R_AllowFog( true );
+}
