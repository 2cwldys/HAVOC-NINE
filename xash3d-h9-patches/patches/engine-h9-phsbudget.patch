diff --git a/engine/common/mod_bmodel.c b/engine/common/mod_bmodel.c
index d1fe48e2..ad03eb3f 100644
--- a/engine/common/mod_bmodel.c
+++ b/engine/common/mod_bmodel.c
@@ -3701,6 +3701,63 @@ static void Mod_CalcPHS( model_t *mod )
 	if( !mod->visdata )
 		return;
 
+	// H9: building the PHS takes rowbytes * count * 2 bytes at once, and for every leaf one row
+	// merged in per leaf it can see. Either can outgrow what a server can afford on a big, open map:
+	// one New Byzantium build needed 521 MB here, and a later one, from whose average leaf 60% of its
+	// 26,388 leaves are visible, about 1,400 GB of merging, hours of a frozen load. Past either budget
+	// no PHS is built: Mod_FatPVS then treats every leaf as audible (its own fallback), so sounds and
+	// PAS messages reach every player.
+	const uint64_t phs_bytes = (uint64_t)rowbytes * count * 2;
+	const uint64_t phs_budget = (uint64_t)192 << 20;
+	if( phs_bytes > phs_budget )
+	{
+		Con_Printf( "PHS not built: %u leaves would need %u MB, past the %u MB budget; sounds reach every player\n",
+			(uint)count, (uint)( phs_bytes >> 20 ), (uint)( phs_budget >> 20 ));
+		return;
+	}
+
+	// the merging: rowbytes for every visible leaf of every leaf, counted from the compressed PVS
+	// before anything is allocated; a leaf without visinfo sees every leaf, as Mod_DecompressPVS has it
+	{
+		const uint64_t work_budget = (uint64_t)8 << 30; // bytes merged: a few seconds of work
+		uint64_t visible = 0;
+
+		for( i = 0; i < count; i++ )
+		{
+			const byte *in = mod->leafs[i].compressed_vis;
+			size_t covered = 0;
+
+			if( !in )
+			{
+				visible += (uint64_t)world.visbytes * 8;
+				continue;
+			}
+
+			while( covered < world.visbytes )
+			{
+				if( *in )
+				{
+					for( uint bits = *in; bits; bits &= bits - 1 )
+						visible++;
+					in++;
+					covered++;
+				}
+				else
+				{
+					covered += in[1];
+					in += 2;
+				}
+			}
+		}
+
+		if( visible * rowbytes > work_budget )
+		{
+			Con_Printf( "PHS not built: %u leaves see %u leaves each on average, %u GB of merging, past the %u GB budget; sounds reach every player\n",
+				(uint)count, (uint)( visible / count ), (uint)(( visible * rowbytes ) >> 30 ), (uint)( work_budget >> 30 ));
+			return;
+		}
+	}
+
 #if defined( HAVE_OPENMP )
 	Con_Reportf( "Building PHS in %d threads...\n", omp_get_max_threads( ));
 #else
@@ -3769,6 +3826,18 @@ static void Mod_CalcPHS( model_t *mod )
 
 	// since I can't predict at which spot compressed array
 	// should be put, this loop is single threaded
+	// H9: two passes, sizing the compressed array first so it is allocated once. Growing it row by
+	// row copies everything compressed so far each time: quadratic in the leaf count.
+	for( i = 0; i < count; i++ )
+	{
+		byte temp_compressed_row[(MAX_MAP_LEAFS+1)/4]; // compression for this row might be ineffective
+
+		total_compressed_size += Mod_CompressPVS( temp_compressed_row, &uncompressed_phs[rowbytes * i], rowbytes );
+	}
+
+	world.compressed_phs = Mem_Malloc( mod->mempool, total_compressed_size );
+	total_compressed_size = 0;
+
 	for( i = 0; i < count; i++ )
 	{
 		const byte *src = &uncompressed_phs[rowbytes * i];
@@ -3776,7 +3845,6 @@ static void Mod_CalcPHS( model_t *mod )
 
 		size_t compressed_size = Mod_CompressPVS( temp_compressed_row, src, rowbytes );
 
-		world.compressed_phs = Mem_Realloc( mod->mempool, world.compressed_phs, total_compressed_size + compressed_size );
 		memcpy( &world.compressed_phs[total_compressed_size], temp_compressed_row, compressed_size );
 		world.phsofs[i]	= total_compressed_size;
 
