--- a/engine/server/sv_main.c
+++ b/engine/server/sv_main.c
@@ -867,6 +867,10 @@ void SV_Init( void )
 
 	SV_InitHostCommands();
 
+	// H9: a per-map cfg from the mapconfigs/ folder, named after the map, queued by SV_ActivateServer.
+	// Default on; a host sets this to 0 to opt out without removing the cfg files themselves.
+	Cvar_Get( "h9_autoconfig", "1", FCVAR_ARCHIVE, "H9: exec mapconfigs/<mapname>.cfg once the map and its plugins are up" );
+
 	Cvar_Getf( "protocol", FCVAR_READ_ONLY, "displays server protocol version", "%i", PROTOCOL_VERSION );
 	Cvar_Get( "suitvolume", "0.25", FCVAR_ARCHIVE, "HEV suit volume" );
 	Cvar_Get( "gamedir", GI->gamefolder, FCVAR_READ_ONLY, "game folder" );
--- a/engine/server/sv_init.c
+++ b/engine/server/sv_init.c
@@ -597,6 +597,12 @@ void SV_ActivateServer( int runPhysics )
 	svgame.globals->time = sv.time;
 	svgame.dllFuncs.pfnServerActivate( svgame.edicts, svgame.numEntities, svs.maxclients );
 
+	// H9: the per-map cfg from mapconfigs/, queued only after ServerActivate, where Metamod/AMX Mod X
+	// register plugin cvars and run their own configs -- so it runs after them and can override them.
+	// The game DLL executes the command buffer during worldspawn, too early for any plugin cvar.
+	if( Cvar_VariableValue( "h9_autoconfig" ) != 0.0f )
+		Cbuf_AddTextf( "exec mapconfigs/%s.cfg\n", sv.name );
+
 	SV_SetStringArrayMode( true );
 
 	// parse user-specified resources
