diff --git a/engine/common/mod_bmodel.c b/engine/common/mod_bmodel.c
index d1fe48e2..252d3105 100644
--- a/engine/common/mod_bmodel.c
+++ b/engine/common/mod_bmodel.c
@@ -2640,6 +2640,31 @@ static void Mod_TextureReplacementReport( const char *modelname, const char *tex
 		Con_Printf( "Looking for %s:%s%s tex replacement..." S_RED "FAIL (%s)\n", modelname, texname, type, foundpath );
 }
 
+// H9: a replacement may be a PNG as well as a TGA, and a PNG wins when both are present.
+//
+// The imagelib has loaded PNG all along -- it is in the loader table in img_utils.c beside TGA,
+// BMP and DDS. Only these lookups were fixed to one extension. H9's upscaled pack ships PNG
+// because it is the same pixels in 41 percent of the bytes, which halves both the download and
+// what sits on a player's disk. TGA is still tried, so a pack built before this, or a file put
+// there by hand, is found exactly as it was.
+//
+// The path is rewritten in place, so whatever the caller loads or reports afterwards names the
+// file that was really found.
+static qboolean Mod_MaterialExists( char *path, size_t size )
+{
+	char *dot = Q_strrchr( path, '.' );
+
+	if( dot != NULL && (size_t)( dot - path ) + 5 <= size )
+	{
+		memcpy( dot, ".png", 5 );
+		if( g_fsapi.FileExists( path, false ))
+			return true;
+		memcpy( dot, ".tga", 5 );
+	}
+
+	return g_fsapi.FileExists( path, false );
+}
+
 static qboolean Mod_SearchForTextureReplacement( char *out, size_t size, const char *modelname, const char *texname, const char *type )
 {
 	const char *subdirs[] = { modelname, "common" };
@@ -2649,7 +2674,7 @@ static qboolean Mod_SearchForTextureReplacement( char *out, size_t size, const c
 		if( Q_snprintf( out, size, "materials/%s/%s%s.tga", subdirs[i], texname, type ) < 0 )
 			continue; // truncated name
 
-		if( g_fsapi.FileExists( out, false ))
+		if( Mod_MaterialExists( out, size ))
 			return true; // found, load it
 	}
 
