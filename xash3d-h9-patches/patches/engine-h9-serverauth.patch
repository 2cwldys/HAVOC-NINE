+++ b/engine/client/cl_h9auth.c
@@ -0,0 +1,257 @@
+/*
+cl_h9auth.c - H9: which game servers havoc9.org vouches for, for the server browser's chain (docs/NETWORKING.txt)
+Copyright (C) 2026 HAVOC 9
+
