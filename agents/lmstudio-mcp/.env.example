# LM Studio API endpoint (default port is 1234)
LM_STUDIO_URL=http://localhost:1234/v1

# The model name to use -- must match the model loaded in LM Studio.
# Run "npm run setup" to pick from your available models interactively.
# Recommended models (download inside LM Studio):
#   qwen2.5-coder-7b-instruct       ~8 GB VRAM  -- best balance
#   qwen2.5-coder-14b-instruct      ~12 GB VRAM -- higher quality
#   deepseek-coder-v2-lite-instruct ~16 GB VRAM -- strongest
#   phi-4-mini-instruct             ~4 GB VRAM  -- low VRAM / CPU
#   llama-3.2-3b-instruct           ~3 GB VRAM  -- ultra-light
MODEL_NAME=qwen2.5-coder-7b-instruct
