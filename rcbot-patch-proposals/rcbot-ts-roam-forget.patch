+eBotCvarState CRoamForgetCommand::action(CClient* pClient, const char* arg1, const char* arg2, const char* arg3, const char* arg4)
+{
+	if (arg1 == nullptr || *arg1 == '\0')
+		return BOT_CVAR_ERROR;
+
+	const int iIndex = std::atoi(arg1);
+
+	if (iIndex < 1 || iIndex > gpGlobals->maxClients)
+		return BOT_CVAR_ERROR;
+
+	const edict_t* pPlayer = INDEXENT(iIndex);
+
+	if (pPlayer == nullptr || pPlayer->free)
+		return BOT_CVAR_ERROR;
+
+	for (CBot& bot : gBotGlobals.m_Bots)
+	{
+		if (bot.IsUsed())
+			bot.RoamForgetAttacker(pPlayer);
+	}
+
+	return BOT_CVAR_ACCESSED;
+}
