# vim: set sts=2 ts=8 sw=2 tw=99 et ft=python:
import os.path

if AMXX.mysql_path:
  binary = AMXX.MetaModule(builder, 'mysql')

  # AMXX.mysql_path == 'system' selects the distro libmariadb-dev
  # layout: headers in /usr/include/mariadb (Debian/Ubuntu) and the
  # runtime library libmariadb.so.3 on the linker's default search
  # path. Dynamic link only — the deploy host needs libmariadb3
  # installed (the standard runtime package on any MariaDB / MySQL
  # client host).
  #
  # Any other AMXX.mysql_path value selects the legacy explicit-tree
  # layout: <path>/include for headers and <path>/lib/libmysqlclient_r.a
  # for static link.
  use_system = AMXX.mysql_path == 'system'

  if use_system:
    binary.compiler.cxxincludes += [
      '/usr/include/mariadb',
      os.path.join(builder.currentSourcePath, 'mysql'),
      os.path.join(builder.currentSourcePath, 'thread'),
    ]
  else:
    binary.compiler.cxxincludes += [
      os.path.join(AMXX.mysql_path, 'include'),
      os.path.join(builder.currentSourcePath, 'mysql'),
      os.path.join(builder.currentSourcePath, 'thread'),
    ]

  binary.compiler.defines += [
    'SM_DEFAULT_THREADER',
    'HAVE_STDINT_H',
  ]

  binary.sources = []

  if builder.target_platform == 'linux' or builder.target_platform == 'mac':
    binary.compiler.defines += ['stricmp=strcasecmp']
    if use_system:
      # `-l:libmariadb.so.3` resolves the versioned .so directly without
      # needing a libmariadb.so symlink. Works on every multiarch path
      # that has libmariadb3 installed.
      binary.compiler.linkflags += [
        '-l:libmariadb.so.3',
        '-lpthread',
        '-lm',
      ]
    else:
      # The archive may carry its TLS library (OpenSSL) inside. Keep everything it brings local to
      # the module, so the client's calls cannot bind to another copy already in the process (an
      # engine linked against a different libssl, for one).
      binary.compiler.linkflags += [
        os.path.join(AMXX.mysql_path, 'lib', 'libmysqlclient_r.a'),
        '-Wl,--exclude-libs,ALL',
        '-lpthread',
        '-ldl',
        '-lm',
      ]
    if builder.target_platform == 'linux':
      binary.compiler.linkflags += [
        '-lrt'
      ]
  elif builder.target_platform == 'windows':
    binary.compiler.linkflags += [
      os.path.join(AMXX.mysql_path, 'lib', 'mysqlclient.lib'),
      'ws2_32.lib',
      # MariaDB Connector/C 3.1.x links Windows Schannel for TLS, which
      # the static mariadbclient.lib pulls in via schannel_certs.obj +
      # ma_tls_schannel.obj. The system libs below resolve those refs;
      # they're always-present Windows DLLs, harmless if not actually
      # needed (e.g. when the connector used to be Oracle's 6.1.1 here).
      'crypt32.lib',    # Cert*/Crypt* — certificate APIs
      'secur32.lib',    # SSPI / Schannel — FreeCredentialsHandle etc.
      'shlwapi.lib',    # PathRemoveFileSpecA
      '/SECTION:.data,RW'
    ]
    if AMXX.target_arch == 'i386':
      binary.compiler.linkflags += ['/EXPORT:GiveFnptrsToDll=_GiveFnptrsToDll@8,@1']
    else:
      binary.compiler.linkflags += ['/EXPORT:GiveFnptrsToDll,@1']
    if binary.compiler.vendor == 'msvc' and binary.compiler.version >= 1900:
       binary.sources += [
        '../../public/msvc/msvc15hack.c'
      ]

  binary.compiler.linkflags += [AMXX.zlib.binary]

  binary.sources += [
    'basic_sql.cpp',
    'handles.cpp',
    'module.cpp',
    'threading.cpp',
    '../../public/sdk/amxxmodule.cpp',
    'oldcompat_sql.cpp',
    'thread/BaseWorker.cpp',
    'thread/ThreadWorker.cpp',
    'mysql/MysqlQuery.cpp',
    'mysql/MysqlResultSet.cpp',
    'mysql/MysqlDatabase.cpp',
    'mysql/MysqlDriver.cpp',
  ]

  if builder.target_platform == 'windows':
    binary.sources += ['version.rc']

  if builder.target_platform == 'windows':
    binary.sources += [
      'thread/WinThreads.cpp',
    ]
  else:
    binary.sources += [
      'thread/PosixThreads.cpp',
    ]

  AMXX.modules += [builder.Add(binary)]
