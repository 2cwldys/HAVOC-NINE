# vim: set sts=2 ts=8 sw=2 tw=99 et ft=python:
import os.path

binary = AMXX.MetaModule(builder, 'regex')

# PCRE is built per-arch from tools/pcre/ — the prebuilt
# lib_<plat>/libpcre.a / lib_win/pcre.lib archives are x86-only and
# can't link into 64-bit shared libs. The msvc12 project files retain
# the prebuilt independently; this AMBuild path uses from-source for
# every arch (Linux i386/amd64/aarch64 + Windows Win32/x64).
binary.compiler.linkflags += [AMXX.pcre.binary]
binary.compiler.includes += [
  os.path.join(builder.sourcePath, 'tools', 'pcre'),
]

binary.compiler.defines += [
  'PCRE_STATIC',
  'HAVE_STDINT_H',
]

binary.sources = [
  '../../public/sdk/amxxmodule.cpp',
  'module.cpp',
  'CRegEx.cpp',
  'utils.cpp',
]

if builder.target_platform == 'windows':
  binary.sources += ['version.rc']
  if binary.compiler.vendor == 'msvc' and binary.compiler.version >= 1900:
    binary.sources += [
    '../../public/msvc/msvc15hack.c'
  ]

AMXX.modules += [builder.Add(binary)]
