import os.path

binary = AMXX.MetaModule(builder, 'hamsandwich')

binary.compiler.defines += [
  'HAVE_STDINT_H',
  'ASMJIT_STATIC',
]

binary.compiler.cxxincludes += [
  os.path.join(builder.sourcePath, 'extern', 'asmjit'),
  os.path.join(builder.sourcePath, 'extern', 'asmjit', 'asmjit'),
]

# AsmJit needs C++17. Drop project-wide -std= and set 17 just for this binary.
# MSVC and GCC spell the flag differently; pick the right form so cl.exe
# doesn't silently fall back to C++14 (which downgrades `const` at namespace
# scope to internal linkage and breaks hook_signatures.cpp ↔ hook_native.cpp).
binary.compiler.cxxflags = [
  f for f in binary.compiler.cxxflags
  if not f.startswith('-std=') and not f.startswith('/std:')
]
if builder.compiler.like('msvc'):
  binary.compiler.cxxflags += ['/std:c++17']
else:
  binary.compiler.cxxflags += ['-std=c++17']

binary.compiler.linkflags += [AMXX.asmjit.binary]

# AsmJit's executable memory uses shm_open, which is in librt before glibc 2.34.
if builder.target_platform == 'linux':
  binary.compiler.linkflags += ['-lrt']

binary.sources = [
  '../../public/sdk/amxxmodule.cpp',
  '../../public/memtools/MemoryUtils.cpp',
  'amxx_api.cpp',
  'config_parser.cpp',
  'hook_callbacks.cpp',
  'hook_native.cpp',
  'srvcmd.cpp',
  'call_funcs.cpp',
  'hook_create.cpp',
  'hook_signatures.cpp',
  'Trampolines.cpp',
  'DataHandler.cpp',
  'pdata.cpp',
  'hook_specialbot.cpp',
]

if builder.target_platform == 'windows':
    binary.sources += ['version.rc']
    binary.compiler.linkflags += ['/SECTION:.data,RW']
    if AMXX.target_arch == 'i386':
      # x86 stdcall name decoration — alias the clean symbol to the
      # decorated one. On x64 there's no decoration; nothing to alias.
      binary.compiler.linkflags += [
        '/EXPORT:GiveFnptrsToDll=_GiveFnptrsToDll@8,@1',
      ]
    else:
      binary.compiler.linkflags += [
        '/EXPORT:GiveFnptrsToDll,@1',
      ]

AMXX.modules += [builder.Add(binary)]
