# h9web's state and the settings of one machine: never committed.
# data/ holds secrets.json (the player id key and the password pepper) and the database.
data/
*.db
*.db-wal
*.db-shm
secrets.json
config.json
servers.json
node_modules/
# The data key (it opens the Discord links), any other key, h9web-backup's archives and the
# backup passphrase file: never committed, wherever they are put.
data.key
*.key
*.h9backup
*.h9backup.partial
backup-passphrase*
