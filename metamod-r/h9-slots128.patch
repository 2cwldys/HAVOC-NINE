diff --git a/metamod/src/mplayer.h b/metamod/src/mplayer.h
--- a/metamod/src/mplayer.h
+++ b/metamod/src/mplayer.h
@@ -26,5 +26,9 @@
 	const char* is_querying_cvar(const edict_t* pEntity) const;
 
 private:
-	MPlayer m_players[MAX_CLIENTS + 1]; // array of players
+	// Every player slot a server can have: H9's engine and game DLLs are built for 128 (the
+	// HLSDK's MAX_CLIENTS in const.h is 32). Every look-up is bounded by it as well as by
+	// maxClients.
+	enum { MAX_SLOTS = 128 };
+	MPlayer m_players[MAX_SLOTS + 1]; // array of players
 };
diff --git a/metamod/src/mplayer.cpp b/metamod/src/mplayer.cpp
--- a/metamod/src/mplayer.cpp
+++ b/metamod/src/mplayer.cpp
@@ -45,7 +45,7 @@
 void MPlayerList::set_player_cvar_query(const edict_t* pEntity, const char* cvar)
 {
 	int indx = ENTINDEX(pEntity);
-	if (indx >= 1 && indx <= gpGlobals->maxClients) {
+	if (indx >= 1 && indx <= gpGlobals->maxClients && indx <= MAX_SLOTS) {
 		m_players[indx].set_cvar_query(cvar);
 	}
 }
@@ -54,14 +54,14 @@
 void MPlayerList::clear_player_cvar_query(const edict_t* pEntity, const char* cvar)
 {
 	int indx = ENTINDEX(pEntity);
-	if (indx >= 1 && indx <= gpGlobals->maxClients) {
+	if (indx >= 1 && indx <= gpGlobals->maxClients && indx <= MAX_SLOTS) {
 		m_players[indx].clear_cvar_query(cvar);
 	}
 }
 
 void MPlayerList::clear_all_cvar_queries()
 {
-	for (int indx = 1; indx <= gpGlobals->maxClients; indx++) {
+	for (int indx = 1; indx <= gpGlobals->maxClients && indx <= MAX_SLOTS; indx++) {
 		m_players[indx].clear_cvar_query();
 	}
 }
@@ -74,7 +74,7 @@
 const char* MPlayerList::is_querying_cvar(const edict_t* pEntity) const
 {
 	int indx = ENTINDEX(pEntity);
-	if (indx >= 1 && indx <= gpGlobals->maxClients) {
+	if (indx >= 1 && indx <= gpGlobals->maxClients && indx <= MAX_SLOTS) {
 		return m_players[indx].is_querying_cvar();
 	}
 
