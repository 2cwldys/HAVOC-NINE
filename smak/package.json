{
  "name": "smak",
  "version": "0.4.0",
  "description": "SMAK, the Studio Model Agent Kit: GoldSrc studio models (.mdl) read, made, changed, checked and drawn from Node, by an AI agent, with no decompiler, no studiomdl and no dependencies.",
  "type": "module",
  "main": "src/index.mjs",
  "exports": {
    ".": "./src/index.mjs",
    "./workshop": "./src/workshop.mjs",
    "./kits/*": "./kits/*.mjs",
    "./src/*": "./src/*.mjs"
  },
  "bin": {
    "smak": "bin/smak.mjs"
  },
  "scripts": {
    "test": "node test/selftest.mjs"
  },
  "engines": {
    "node": ">=18"
  },
  "files": [
    "bin",
    "src",
    "kits",
    "viewer",
    "editor/serve.mjs",
    "editor/project.mjs",
    "editor/core.mjs",
    "editor/cli.mjs",
    "editor/page",
    "editor/README.md",
    "editor/AGENTS.md",
    "examples",
    "docs",
    "test/selftest.mjs",
    "README.md",
    "CHANGELOG.md",
    "AGENTS.md",
    "CLAUDE.md",
    "LICENSE"
  ],
  "keywords": [
    "goldsrc",
    "half-life",
    "xash3d",
    "mdl",
    "studiomdl",
    "modding"
  ],
  "license": "MIT",
  "private": true
}
