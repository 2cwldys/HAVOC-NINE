  <script src="../script.js"></script>
  <script>
    (function () {
      var box = document.getElementById("masterBox");
      var list = document.getElementById("serverList");
      var url = (box && box.getAttribute("data-master") || "").trim();
      if (!url) return;
      fetch(url)
        .then(function (r) { if (!r.ok) throw new Error("bad status"); return r.text(); })
        .then(function (text) {
          var lines = text.split(/\r?\n/).map(function (l) { return l.trim(); }).filter(Boolean);
          var rows = lines.filter(function (l) { return /^(ip|gs)\s+\S+/i.test(l); });
          if (!rows.length) return;
          list.innerHTML = "";
          rows.forEach(function (line) {
            var parts = line.split(/\s+/);
            var kind = parts[0].toLowerCase();
            var addr = parts.slice(1).join(" ");
            var card = document.createElement("div");
            card.className = "server-card";
            card.innerHTML =
              '<div class="server-status"><span class="status-dot online"></span><span class="status-text">LIVE</span></div>' +
              '<div class="server-info"><h3 class="server-name">' + (kind === "gs" ? "GOLDSRC" : "XASH") + "</h3>" +
              '<p class="server-addr">connect ' + addr.replace(/[<>&"]/g, "") + "</p></div>";
            list.appendChild(card);
          });
        })
        .catch(function () {});
    })();
  </script>
